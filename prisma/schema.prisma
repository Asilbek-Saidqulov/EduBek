  @@index([module, status])
  @@index([status, createdAt])
  @@index([kind, createdAt])
}

/// Feature flags — runtime rollout control.
model OrchestratorFeatureFlag {
  key             String   @id
  description     String   @default("")
  enabled         Boolean  @default(false)
  rollout         Int      @default(0)
  cohorts         String   @default("[]")
  updatedAt       DateTime @default(now()) @updatedAt
  createdAt       DateTime @default(now())

  @@index([enabled])
}

/// Circuit breakers — runtime state per protected operation.
model OrchestratorCircuitBreaker {
  name            String   @id
  module          String
  state           String   @default("closed")
  failureCount    Int      @default(0)
  failureThreshold Int     @default(5)
  lastFailureAt   DateTime?
  resetAt         DateTime?
  successCount    Int      @default(0)
  updatedAt       DateTime @default(now()) @updatedAt
  createdAt       DateTime @default(now())

  @@index([module, state])
}

/// Idempotency keys — prevents duplicate work on retries.
model OrchestratorIdempotencyKey {
  key             String   @id
  status          String   @default("pending")
  responseHash    String?
  responsePayload String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([status, expiresAt])
}

/// Distributed locks — short-lived, process-scoped.
model OrchestratorDistributedLock {
  id              String   @id @default(cuid())
  resource        String
  holder          String
  acquiredAt      DateTime @default(now())
  expiresAt       DateTime
  releasedAt      DateTime?

  @@index([resource, expiresAt])
  @@index([holder])
}

/// Detected issues that may trigger self-healing.
model OrchestratorDetectedIssue {
  id              String   @id @default(cuid())
  module          String
  severity        String   @default("low")
  description     String
  detectedAt      DateTime @default(now())
  autoHealable    Boolean  @default(true)
  resolvedAt      DateTime?
  resolution      String?

  @@index([module, severity, detectedAt])
  @@index([resolvedAt])
}

