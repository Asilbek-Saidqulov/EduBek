// PHASE 5B.3 — EDUCATIONAL DATA FABRIC, REAL-TIME INTELLIGENCE & GLOBAL LEARNING NETWORK
// =============================================================================

model DataFabricEntity {
  id              String   @id @default(cuid())
  // Unified entity type: 'student' | 'teacher' | 'classroom' | 'organization' | 'resource' | 'quiz' | 'assessment' | 'competency' | 'certificate' | 'marketplace_asset' | 'ai_session' | 'workflow' | 'digital_twin' | 'extension' | 'integration'
  entityType      String
  entityId        String
  // Organization that owns this entity (tenant isolation)
