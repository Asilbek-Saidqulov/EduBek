model ExtensionVersion {
  id              String   @id @default(cuid())
  extensionId     String
  extension       Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  version         String
  // Changelog
  changelog       String?
  // Package URL (where the extension code is hosted)
  packageUrl      String?
  packageHash     String?
  // Status: 'pending' | 'approved' | 'published' | 'rejected' | 'deprecated'
  status          String   @default("pending")
  // Permissions for this version
  permissions     String   @default("[]")
  // Hooks for this version
  hooks           String   @default("[]")
  // Min platform version
  minPlatformVersion String?
  // File size
  fileSize        Int?
  createdAt       DateTime @default(now())

  @@unique([extensionId, version])
  @@index([extensionId, status])
}

model ExtensionInstall {
  id              String   @id @default(cuid())
  extensionId     String
  extension       Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  organizationId  String?
  userId          String?
  // Installed version
  version         String
  // Configuration
  config          String   @default("{}")
  // Status: 'installed' | 'enabled' | 'disabled' | 'error' | 'uninstalled'
  status          String   @default("installed")
  // Permissions approved by the installer
  approvedPermissions String @default("[]")
  // Sandbox settings
  cpuLimit        Int      @default(50)      // percentage
  memoryLimitMb   Int      @default(128)     // MB
  timeoutMs       Int      @default(30000)   // 30s default
  networkEnabled  Boolean  @default(false)
  // Installation metadata
  installedBy     String
  installedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([extensionId, status])
  @@index([organizationId, status])
  @@index([userId, status])
}

model ExtensionHook {
  id              String   @id @default(cuid())
  extensionInstallId String
  // Hook event: 'quiz.published' | 'assignment.submitted' | 'resource.created' | 'ai.generated' | 'assessment.graded' | etc.
  event           String
  // Hook handler type: 'sync' | 'async' | 'scheduled'
  handlerType     String   @default("async")
  // Priority (lower = higher priority)
  priority        Int      @default(100)
  // Whether the hook is active
  enabled         Boolean  @default(true)
  // Execution count
  executionCount  Int      @default(0)
  lastExecutedAt  DateTime?
  createdAt       DateTime @default(now())

  @@index([extensionInstallId])
  @@index([event, enabled])
}

model ExtensionExecution {
  id              String   @id @default(cuid())
