// =============================================================================
// EduBek — Prisma Schema
// =============================================================================
//
// This schema implements the data model for the EduBek AI-powered education
// ecosystem. It covers all 10 systems from the EduBek Philosophy document
// (Chapter 14):
//
//   1. User System          — profiles, roles, sessions, devices, notifications
//   2. Organization System  — orgs, memberships, roles, invitations, cohorts
//   3. Marketplace System   — listings, prices, purchases, reviews, refunds
//   4. Creator Economy      — creators, tiers, subscriptions, earnings, payouts
//   5. Economy System       — wallets, EduToken ledger, transactions, invoices
//   6. AI Assistant System  — conversations, messages, decision log, usage log
//   7. Quiz Platform        — quizzes, questions, sessions, attempts, reviews
//   8. Analytics System     — events, daily stats, performance roll-ups
//   9. Search System        — search index, embeddings, recommendations
//  10. Library System       — libraries, items, collections, access
//
// The schema uses SQLite (per the sandbox constraint) but is designed to be
// portable to Postgres for production. The main differences:
//   - SQLite has no native UUID/JSONB/array types; we use String (cuid) and
//     String (JSON serialized) respectively.
//   - SQLite has no RLS; row-level access control is enforced in the service
//     layer (same as the legacy QuizOK codebase after Phase 0).
//   - Enums are modeled as String with a CHECK constraint via Prisma's
//     `@map` + native SQLite constraints (not used here for simplicity).
//
// See the EduBek Philosophy document (chapters 1-16) for the full design.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// 1. USER SYSTEM
// =============================================================================

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  emailVerified        DateTime?
  passwordHash         String?
  name                 String?
  username             String?               @unique
  avatarUrl            String?
  bio                  String?
  country              String?               // ISO 3166-1 alpha-2
  timezone             String?               // IANA tz, e.g. "Asia/Tashkent"
  locale               String?               @default("uz") // ISO 639-1
  phone                String?
  phoneVerified        DateTime?
  mfaSecretEncrypted   String?
  isBanned             Boolean               @default(false)
  bannedReason         String?
  bannedUntil          DateTime?
  lastLoginAt          DateTime?
  lastLoginIpHash      String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  // Relations
  profile              Profile?
  roles                UserRole[]
  permissions          UserPermission[]
  sessions             UserSession[]
  devices              UserDevice[]
  notifications        UserNotification[]
  notificationPrefs    UserNotificationPreference[]
  achievements         UserAchievement[]
  streaks              UserStreak?
  blocks               UserBlock[]           @relation("UserBlocks_Blocker")
  blockedBy            UserBlock[]           @relation("UserBlocks_Blocked")
  follows              UserFollow[]          @relation("UserFollows_Follower")
  followedBy           UserFollow[]          @relation("UserFollows_Followee")
  wallet               Wallet?
  orgMemberships       OrganizationMembership[]
  orgOwned             Organization[]        @relation("OrgOwner")
  orgInvitationsSent   OrganizationInvitation[] @relation("OrgInvitationInviter")
  creatorProfile       Creator?
  quizCreated          Quiz[]
  quizAttempts         QuizAttempt[]
  libraryOwned         Library[]
  libraryItemsAdded    LibraryItem[]
  marketplaceListings  MarketplaceListing[]  @relation("ListingSeller")
  marketplacePurchases MarketplacePurchase[] @relation("PurchaseBuyer")
  marketplaceReviews   MarketplaceReview[]
  aiConversations      AiConversation[]
  aiFeedback           AiFeedback[]
  events               AnalyticsEvent[]
  searchQueries        SearchQueryLog[]
  recommendations      Recommendation[]
  userPreferences      UserPreferences?

  creatorSubscriptions CreatorSubscription[] @relation("CreatorSubSubscriber")
  transactionsAsBuyer Transaction[] @relation("TransactionBuyer")
  userSubs UserSubscription[] @relation("UserUserSubscriptions")
  invoicesOwned Invoice[] @relation("UserInvoices")
  aiDecisions          AiDecision[]                 @relation("UserAiDecisions")
  aiUsageLogs          AiUsageLog[] @relation("UserAiUsageLogs")
  funnelEvents         FunnelEvent[]                @relation("UserFunnelEvents")
  couponUsages         CouponUsage[]                @relation("UserCouponUsages")
  mpListings           MpListing[]                  @relation("UserMpListings")
  mpFavorites          MpFavorite[]                 @relation("UserMpFavorites")
  mpPurchases          MpPurchase[]                 @relation("UserMpPurchases")
  mpReviews            MpReview[]                   @relation("UserMpReviews")
  mpWishlist           MpWishlist[]                 @relation("UserMpWishlist")
  aiSessions           AiSession[]                  @relation("UserAiSessions")
  classroomsAsTeacher  Classroom[]                  @relation("TeacherClassrooms")
  classroomsAsStudent  ClassroomStudent[]           @relation("StudentClassrooms")
  assignmentAttempts   AssignmentAttempt[]          @relation("StudentAttempts")
  learningSessions     LearningSession[]            @relation("StudentLearningSessions")
  progressRecords      ProgressRecord[]             @relation("StudentProgress")
  // Phase 4B — Assessment Engine
  questions            BankQuestion[]               @relation("UserBankQuestions")
  questionVersions      BankQuestionVersion[]        @relation("UserBankQuestionVersions")
  assessments          Assessment[]                 @relation("UserAssessments")
  assessmentAttempts   AssessmentAttempt[]          @relation("UserAssessmentAttempts")
  rubrics              Rubric[]                     @relation("UserRubrics")
  grades               GradebookEntry[]             @relation("UserGradebookEntries")
  certificates         Certificate[]                @relation("UserCertificates")
  certificatesIssued   Certificate[]                @relation("UserCertificatesIssued")
  proctoringIncidents  ProctoringIncident[]         @relation("UserProctoringIncidents")
  plagiarismReports    PlagiarismReport[]           @relation("UserPlagiarismReports")
  // Phase 4C — Live Quiz Engine
  liveSessionsHosted   LiveSession[]                @relation("HostedLiveSessions")
  livePlayers          LivePlayer[]                 @relation("UserLivePlayers")
  tournamentsHosted    Tournament[]                 @relation("HostedTournaments")
  gameRewards          GameReward[]                 @relation("UserGameRewards")
  @@index([email])
  @@index([username])
  @@index([isBanned])
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String?
  level           Int      @default(1)
  xp              Int      @default(0)
  followersCount  Int      @default(0)
  followingCount  Int      @default(0)
  gamesCreated    Int      @default(0)
  gamesPlayed     Int      @default(0)
  accuracy        Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("user") // 'user' | 'creator' | 'moderator' | 'admin' | 'superadmin'
  grantedBy String?
  grantedAt DateTime @default(now())
  expiresAt DateTime?

  @@unique([userId, role])
  @@index([userId])
}

model UserPermission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String // e.g. 'marketplace.publish', 'org.billing.read'
  granted   Boolean  @default(true)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
}

model UserSession {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash   String    @unique
  deviceId           String?
  userAgent          String?
  ipHash             String?
  issuedAt           DateTime  @default(now())
  expiresAt          DateTime
  revokedAt          DateTime?
  lastUsedAt         DateTime?

  @@index([userId])
  @@index([refreshTokenHash])
}

model UserDevice {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceFingerprint String   @unique
  name              String?
  platform          String?
  lastSeenAt        DateTime @default(now())
  isTrusted         Boolean  @default(false)

  @@index([userId])
}

model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // 'purchase' | 'review' | 'payout' | 'system' | ...
  title     String
  body      String?
  data      String?   // JSON string
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model UserNotificationPreference {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String  // 'email' | 'push' | 'sms' | 'in_app'
  category  String  // 'purchases' | 'reviews' | 'payouts' | ...
  enabled   Boolean @default(true)

  @@unique([userId, channel, category])
}

model UserAchievement {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String  // reference to a static achievement catalog
  earnedAt     DateTime @default(now())
  metadata     String?  // JSON string

  @@unique([userId, achievementId])
}

model UserStreak {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)
  lastActivityDay   DateTime?
  updatedAt         DateTime @updatedAt
}

model UserBlock {
  id         String   @id @default(cuid())
  blockerId  String
  blocker    User     @relation("UserBlocks_Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId  String
  blocked    User     @relation("UserBlocks_Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("UserFollows_Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId  String
  followee    User     @relation("UserFollows_Followee", fields: [followeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followeeId])
  @@index([followeeId])
}

// =============================================================================
// 2. ORGANIZATION SYSTEM
// =============================================================================

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  type          String   @default("school") // 'school' | 'company' | 'publisher' | 'cohort'
  ownerId       String
  owner         User     @relation("OrgOwner", fields: [ownerId], references: [id])
  billingEmail  String?
  country       String?  // ISO 3166-1 alpha-2
  plan          String   @default("free") // 'free' | 'pro' | 'enterprise'
  seats         Int      @default(10)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   OrganizationMembership[]
  roles         OrganizationRole[]
  invitations   OrganizationInvitation[]
  billing       OrganizationBilling?
  cohorts       OrganizationCohort[]
  libraries     Library[]                @relation("OrgLibrary")
  quizzes       Quiz[]                   @relation("QuizOrg")
  aiSessions    AiSession[]              @relation("OrgAiSessions")
  mpListings    MpListing[]              @relation("OrgMpListings")
  classrooms    Classroom[]              @relation("OrgClassrooms")
  // Phase 4B — Assessment Engine
  assessments   Assessment[]             @relation("OrgAssessments")
  rubrics       Rubric[]                 @relation("OrgRubrics")
  questionBanks BankQuestion[]           @relation("OrgBankQuestions")
  // Phase 4C — Live Quiz Engine
  liveSessions  LiveSession[]            @relation("OrgLiveSessions")
  tournaments   Tournament[]             @relation("OrgTournaments")

  @@index([slug])
  @@index([ownerId])
}

model OrganizationRole {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String   // 'admin' | 'teacher' | 'student' | 'ta'
  permissions String   // JSON string, e.g. '{"quiz.create":true,"org.billing.read":false}'
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([orgId, name])
  @@index([orgId])
}

model OrganizationMembership {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String?
  status    String   @default("active") // 'active' | 'invited' | 'suspended'
  joinedAt  DateTime @default(now())
  expiresAt DateTime?

  @@unique([orgId, userId])
  @@index([userId])
}

model OrganizationInvitation {
  id         String    @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email      String
  roleId     String?
  token      String    @unique
  invitedById String
  invitedBy  User      @relation("OrgInvitationInviter", fields: [invitedById], references: [id])
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([orgId])
  @@index([email])
}

model OrganizationBilling {
  id                String   @id @default(cuid())
  orgId             String   @unique
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stripeCustomerId  String?
  paymentMethodId   String?
  plan              String   @default("free")
  seats             Int      @default(10)
  renewalAt         DateTime?
  balance           Float    @default(0)
  updatedAt         DateTime @updatedAt
}

model OrganizationCohort {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdById String?
  createdAt   DateTime @default(now())

  members     OrganizationCohortMember[]
  quizCohorts QuizCohort[]

  @@index([orgId])
}

model OrganizationCohortMember {
  id        String   @id @default(cuid())
  cohortId  String
  cohort    OrganizationCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  userId    String
  role      String   @default("student") // 'student' | 'teacher' | 'ta'
  joinedAt  DateTime @default(now())

  @@unique([cohortId, userId])
}

// =============================================================================
// 3. MARKETPLACE SYSTEM
// =============================================================================

model MarketplaceCategory {
  id         String   @id @default(cuid())
  slug       String   @unique
  parentId   String?
  parent     MarketplaceCategory? @relation("CategoryParent", fields: [parentId], references: [id])
  children   MarketplaceCategory[] @relation("CategoryParent")
  nameI18n   String   // JSON string, e.g. '{"en":"Mathematics","uz":"Matematika"}'
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  listings   MarketplaceListing[]

  @@index([parentId])
}

model MarketplaceListing {
  id              String   @id @default(cuid())
  sellerId        String
  seller          User     @relation("ListingSeller", fields: [sellerId], references: [id])
  contentType     String   // 'quiz' | 'course' | 'bundle' | 'ai_template'
  contentId       String   // polymorphic FK to Quiz/Course/Bundle
  title           String
  description     String?
  categoryId      String?
  category        MarketplaceCategory? @relation(fields: [categoryId], references: [id])
  priceEduTokens  Int      @default(0)
  priceFiat       Float    @default(0)
  currency        String   @default("USD")
  tier            String   @default("free") // 'free' | 'paid' | 'subscription'
  status          String   @default("draft") // 'draft' | 'pending_review' | 'active' | 'rejected' | 'delisted'
  publishedAt     DateTime?
  reviewedAt      DateTime?
  reviewerId      String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prices          MarketplacePrice[]
  purchases       MarketplacePurchase[]
  reviews         MarketplaceReview[]
  transactionItems TransactionItem[]
  libraryItems    LibraryItem[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([contentType])
}

model MarketplacePrice {
  id             String   @id @default(cuid())
  listingId      String
  listing        MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tier           String   @default("standard") // 'standard' | 'premium' | 'student' | 'org'
  priceEduTokens Int      @default(0)
  priceFiat      Float    @default(0)
  currency       String   @default("USD")
  validFrom      DateTime?
  validUntil     DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  purchases      MarketplacePurchase[]

  @@index([listingId])
}

model MarketplacePurchase {
  id              String   @id @default(cuid())
  buyerId         String
  buyer           User     @relation("PurchaseBuyer", fields: [buyerId], references: [id])
  listingId       String
  listing         MarketplaceListing @relation(fields: [listingId], references: [id])
  priceId         String?
  price           MarketplacePrice? @relation(fields: [priceId], references: [id])
  transactionId   String?
  amountPaid      Float    @default(0)
  currency        String   @default("USD")
  eduTokensSpent  Int      @default(0)
  purchasedAt     DateTime @default(now())
  refundableUntil DateTime?
  licenseType     String   @default("personal") // 'personal' | 'classroom' | 'org'

  review          MarketplaceReview?

  @@index([buyerId])
  refunds         MarketplaceRefund[]
  @@index([listingId])
}

model MarketplaceReview {
  id              String   @id @default(cuid())
  listingId       String
  listing         MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId         String
  buyer           User     @relation(fields: [buyerId], references: [id])
  purchaseId      String   @unique
  purchase        MarketplacePurchase @relation(fields: [purchaseId], references: [id])
  rating          Int      // 1-5
  title           String?
  body            String?
  sellerResponse  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([listingId])
  @@index([buyerId])
}

model MarketplaceRefund {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    MarketplacePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  amount      Float
  reason      String?
  initiatedBy String?
  processedAt DateTime?
  status      String   @default("pending") // 'pending' | 'approved' | 'denied' | 'completed'
  createdAt   DateTime @default(now())

  @@index([purchaseId])
}

// =============================================================================
// 4. CREATOR ECONOMY
// =============================================================================

model Creator {
  userId              String   @id @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName         String?
  bio                 String?
  website             String?
  socialLinks         String?  // JSON string
  verificationStatus  String   @default("unverified") // 'unverified' | 'pending' | 'verified' | 'rejected'
  verifiedAt          DateTime?
  totalEarnings       Float    @default(0)
  totalFollowers      Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tiers               CreatorTier[]
  subscriptions       CreatorSubscription[]
  earnings            CreatorEarning[]
  payouts             CreatorPayout[]
  payoutAccounts      PayoutAccount[]
  platformTier        PlatformCreatorTierAssignment? @relation("CreatorPlatformTier")
}

model CreatorTier {
  id             String   @id @default(cuid())
  creatorId      String
  creator        Creator  @relation(fields: [creatorId], references: [userId], onDelete: Cascade)
  name           String
  priceEduTokens Int      @default(0)
  priceFiat      Float    @default(0)
  currency       String   @default("USD")
  benefits       String?  // JSON string
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  subscriptions  CreatorSubscription[]

  @@index([creatorId])
}

model CreatorSubscription {
  id            String    @id @default(cuid())
  subscriberId  String
  subscriber    User      @relation("CreatorSubSubscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  creatorId     String
  creator       Creator   @relation(fields: [creatorId], references: [userId], onDelete: Cascade)
  tierId        String?
  tier          CreatorTier? @relation(fields: [tierId], references: [id])
  transactionId String?
  startedAt     DateTime  @default(now())
  endsAt        DateTime?
  status        String    @default("active") // 'active' | 'cancelled' | 'expired'
  autoRenew     Boolean   @default(false)

  @@index([subscriberId])
  @@index([creatorId])
}

model CreatorEarning {
  id          String   @id @default(cuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [userId], onDelete: Cascade)
  source      String   // 'sale' | 'subscription' | 'tip' | 'payout'
  amount      Float    @default(0)
  currency    String   @default("USD")
  eduTokens   Int      @default(0)
  referenceId String?
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())

  @@index([creatorId, createdAt])
}

model CreatorPayout {
  id                String    @id @default(cuid())
  creatorId         String
  creator           Creator   @relation(fields: [creatorId], references: [userId], onDelete: Cascade)
  amount            Float     @default(0)
  currency          String    @default("USD")
  payoutAccountId   String?
  payoutAccount     PayoutAccount? @relation(fields: [payoutAccountId], references: [id])
  status            String    @default("requested") // 'requested' | 'processing' | 'completed' | 'failed' | 'reversed'
  requestedAt       DateTime  @default(now())
  processedAt       DateTime?
  stripeTransferId  String?
  failureReason     String?

  @@index([creatorId])
}

model PayoutAccount {
  id                String   @id @default(cuid())
  creatorId         String
  creator           Creator  @relation(fields: [creatorId], references: [userId], onDelete: Cascade)
  provider          String   // 'stripe' | 'paypal' | 'bank'
  externalAccountId String?
  country           String?
  isDefault         Boolean  @default(false)
  verifiedAt        DateTime?
  metadata          String?  // JSON string
  createdAt         DateTime @default(now())

  payouts           CreatorPayout[]

  @@index([creatorId])
}

// =============================================================================
// 5. ECONOMY SYSTEM (EduTokens + Real Money)
// =============================================================================

model Wallet {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eduTokensBalance  Int      @default(0)
  fiatBalance       Float    @default(0)
  currency          String   @default("USD")
  lockedEduTokens   Int      @default(0)
  updatedAt         DateTime @updatedAt

  ledgerEntries     EduTokenLedger[]
}

model EduTokenLedger {
  id            String   @id @default(cuid())
  walletId      String
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  delta         Int      // signed: + for credit, - for debit
  balanceAfter  Int
  reason        String   // 'purchase' | 'reward' | 'refund' | 'payout' | 'transfer_in' | 'transfer_out' | 'mint' | 'burn' | 'adjustment'
  referenceType String?
  referenceId   String?
  metadata      String?  // JSON string
  createdAt     DateTime @default(now())

  @@index([walletId, createdAt])
}

model Transaction {
  id                  String   @id @default(cuid())
  buyerId             String
  buyer               User     @relation("TransactionBuyer", fields: [buyerId], references: [id])
  sellerId            String?
  type                String   // 'purchase' | 'subscription' | 'topup' | 'payout' | 'refund'
  grossAmount         Float    @default(0)
  platformFee         Float    @default(0)
  sellerAmount        Float    @default(0)
  currency            String   @default("USD")
  eduTokensInvolved   Int      @default(0)
  status              String   @default("pending") // 'pending' | 'authorized' | 'captured' | 'failed' | 'refunded' | 'disputed'
  provider            String   @default("edu_tokens") // 'stripe' | 'paypal' | 'edu_tokens'
  providerTransactionId String?
  metadata            String?  // JSON string
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  items               TransactionItem[]
  refunds             TransactionRefund[]
  escrow              Escrow?
  invoice             Invoice?
}

model TransactionItem {
  id            String   @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  listingId     String?
  listing       MarketplaceListing? @relation(fields: [listingId], references: [id])
  quantity      Int      @default(1)
  unitPrice     Float    @default(0)
  totalPrice    Float    @default(0)
  eduTokens     Int      @default(0)

  @@index([transactionId])
}

model TransactionRefund {
  id                String   @id @default(cuid())
  transactionId     String
  transaction       Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  amount            Float    @default(0)
  reason            String?
  initiatedBy       String?
  providerRefundId  String?
  status            String   @default("pending") // 'pending' | 'completed' | 'failed'
  createdAt         DateTime @default(now())

  @@index([transactionId])
}

model Escrow {
  id            String    @id @default(cuid())
  transactionId String    @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  amount        Float     @default(0)
  status        String    @default("held") // 'held' | 'released' | 'refunded'
  heldUntil     DateTime?
  releasedAt    DateTime?
}

model SubscriptionPlan {
  id              String   @id @default(cuid())
  name            String
  tier            String   @unique // 'free' | 'pro' | 'ultra'
  priceMonthly    Float    @default(0)
  priceYearly     Float    @default(0)
  currency        String   @default("USD")
  features        String?  // JSON string
  aiCreditsMonthly Int     @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  userSubscriptions UserSubscription[]
  // Phase 4E.5: multilingual translations
  translations SubscriptionPlanTranslation[] @relation("PlanTranslations")
}

model UserSubscription {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation("UserUserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  planId              String
  plan                SubscriptionPlan @relation(fields: [planId], references: [id])
  status              String    @default("active") // 'active' | 'cancelled' | 'expired' | 'past_due'
  startedAt           DateTime  @default(now())
  currentPeriodEnd    DateTime?
  autoRenew           Boolean   @default(false)
  stripeSubscriptionId String?
  cancelledAt         DateTime?

  @@index([userId])
}

model Invoice {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("UserInvoices", fields: [userId], references: [id])
  transactionId String?  @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  number        String   @unique
  amount        Float    @default(0)
  currency      String   @default("USD")
  tax           Float    @default(0)
  pdfUrl        String?
  status        String   @default("draft") // 'draft' | 'open' | 'paid' | 'void'
  issuedAt      DateTime @default(now())
  dueAt         DateTime?

  @@index([userId])
}

// =============================================================================
// 6. AI ASSISTANT SYSTEM
// =============================================================================

model AiConversation {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId          String?
  title          String?
  contextSummary String?
  lastMessageAt  DateTime?
  isArchived     Boolean   @default(false)
  metadata       String?   // JSON string
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  messages       AiMessage[]
  decisions      AiDecision[]
  session        AiSession?

  @@index([userId])
}

model AiMessage {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String   // 'system' | 'user' | 'assistant' | 'tool'
  content         String
  toolCalls       String?  // JSON string
  toolCallId      String?
  model           String?
  tokensIn        Int      @default(0)
  tokensOut       Int      @default(0)
  costUsd         Float    @default(0)
  latencyMs       Int?
  createdAt       DateTime @default(now())

  toolCallRecords AiToolCall[]
  feedback        AiFeedback[]

  @@index([conversationId, createdAt])
}

model AiContextMemory {
  id              String   @id @default(cuid())
  userId          String
  memoryType      String   // 'preference' | 'fact' | 'goal' | 'skill'
  content         String
  confidence      Float    @default(0.5)
  sourceMessageId String?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([userId])
}

model AiDecision {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation("UserAiDecisions", fields: [userId], references: [id], onDelete: Cascade)
  conversationId  String?
  conversation    AiConversation? @relation(fields: [conversationId], references: [id])
  decisionType    String   // 'search_marketplace' | 'recommend' | 'customize' | 'generate' | 'block'
  inputSummary    String?  // JSON string
  output          String?  // JSON string
  rationale       String?
  model           String?
  confidence      Float    @default(0.5)
  wasOverridden   Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

model AiUsageLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserAiUsageLogs", fields: [userId], references: [id], onDelete: Cascade)
  day         DateTime
  model       String?
  feature     String?  // 'quiz_generate' | 'explain' | 'translate' | ...
  requests    Int      @default(0)
  tokensIn    Int      @default(0)
  tokensOut   Int      @default(0)
  costUsd     Float    @default(0)
  createdAt   DateTime @default(now())

  @@unique([userId, day, model, feature])
  @@index([userId, day])
}

model AiToolCall {
  id          String   @id @default(cuid())
  messageId   String
  message     AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  toolName    String   // 'search_marketplace' | 'customize_quiz' | 'combine_resources' | ...
  arguments   String?  // JSON string
  result      String?  // JSON string
  durationMs  Int?
  success     Boolean  @default(true)
  error       String?

  @@index([messageId])
}

model AiPrompt {
  id            String   @id @default(cuid())
  name          String
  version       Int      @default(1)
  systemPrompt  String
  userTemplate  String?
  variables     String?  // JSON string
  isActive      Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())

  @@unique([name, version])
}

model AiFeedback {
  id          String   @id @default(cuid())
  messageId   String
  message     AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      String   // 'up' | 'down'
  comment     String?
  createdAt   DateTime @default(now())

  @@unique([messageId, userId])
}

// =============================================================================
// 7. QUIZ PLATFORM
// =============================================================================

model Quiz {
  id                String   @id @default(cuid())
  title             String
  description       String?
  category          String   @default("general")
  difficulty        String   @default("medium") // 'easy' | 'medium' | 'hard' | 'expert'
  mode              String   @default("classic") // 'classic' | 'survival'
  language          String   @default("uz")
  teacherId         String
  teacher           User     @relation(fields: [teacherId], references: [id])
  orgId             String?
  org               Organization? @relation("QuizOrg", fields: [orgId], references: [id])
  listingId         String?
  version           Int      @default(1)
  parentQuizId      String?
  isPublished       Boolean  @default(false)
  isFeatured        Boolean  @default(false)
  isAiGenerated     Boolean  @default(false)
  aiPromptId        String?
  moderationStatus  String   @default("clean") // 'clean' | 'flagged' | 'removed'
  contentHash       String?
  publishedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  questions         Question[]
  sessions          QuizSession[]
  attempts          QuizAttempt[]
  versions          QuizVersion[]
  reviews           QuizReview[]
  tags              QuizTag[]
  cohorts           QuizCohort[]

  @@index([teacherId])
  @@index([orgId])
  @@index([isPublished])
  @@index([category])
}

model Question {
  id              String   @id @default(cuid())
  quizId          String
  quiz            Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type            String   @default("multiple_choice") // 'multiple_choice' | 'true_false' | 'short_answer' | 'essay'
  question        String
  options         String   // JSON array of strings
  correctIndex    Int      @default(0)
  explanation     String?
  difficulty      String   @default("medium")
  points          Int      @default(1)
  tags            String?  // JSON array
  orderNum        Int      @default(0)
  mediaUrl        String?
  aiGenerated     Boolean  @default(false)
  parentQuestionId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([quizId, orderNum])
}

model QuizSession {
  id              String    @id @default(cuid())
  quizId          String
  quiz            Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  code            String    @unique
  hostId          String?
  status          String    @default("waiting") // 'waiting' | 'playing' | 'ended'
  currentQuestion Int       @default(0)
  mode            String    @default("classic")
  startedAt       DateTime?
  endedAt         DateTime?
  playerCount     Int       @default(0)
  createdAt       DateTime  @default(now())

  players         Player[]
  answers         Answer[]

  @@index([quizId])
  @@index([code])
}

model Player {
  id            String   @id @default(cuid())
  sessionId     String
  session       QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId        String?
  name          String
  avatarUrl     String?
  score         Int      @default(0)
  rank          Int?
  correctCount  Int      @default(0)
  isGuest       Boolean  @default(false)
  deviceId      String?
  joinedAt      DateTime @default(now())

  answers       Answer[]

  @@index([sessionId])
  @@index([userId])
}

model Answer {
  id            String   @id @default(cuid())
  sessionId     String
  session       QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  questionIndex Int
  selectedIndex Int?
  isCorrect     Boolean  @default(false)
  points        Int      @default(0)
  timeTaken     Int?     // ms
  isFlagged     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([sessionId])
  @@index([playerId])
}

model QuizAttempt {
  id            String    @id @default(cuid())
  quizId        String
  quiz          Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohortId      String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  score         Int       @default(0)
  maxScore      Int       @default(0)
  timeSpentMs   Int?
  attemptNumber Int       @default(1)

  @@index([quizId, userId])
}

model QuizVersion {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    String   // JSON string (full quiz + questions at that point)
  changelog   String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([quizId, version])
}

model QuizReview {
  id          String    @id @default(cuid())
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  reviewerId  String?
  status      String    @default("pending") // 'pending' | 'approved' | 'rejected' | 'changes_requested'
  feedback    String?
  reviewedAt  DateTime?

  @@index([quizId])
}

model Tag {
  id       String @id @default(cuid())
  slug     String @unique
  nameI18n String // JSON string
  quizTags QuizTag[]
}

model QuizTag {
  id     String @id @default(cuid())
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([quizId, tagId])
}

model QuizCohort {
  id              String    @id @default(cuid())
  quizId          String
  quiz            Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  cohortId        String
  cohort          OrganizationCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  dueDate         DateTime?
  attemptsAllowed Int       @default(1)

  @@unique([quizId, cohortId])
}

