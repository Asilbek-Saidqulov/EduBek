  @@index([traceId])
  @@index([provider, createdAt])
  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

/// Distributed trace spans across the whole platform.
model OrchestratorTraceSpan {
  id              String   @id @default(cuid())
  spanId          String
  parentSpanId    String?
