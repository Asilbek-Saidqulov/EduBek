  orgId                  String?
  classroomId            String?
  resourceId             String?
  assignmentId           String?
  rubricId               String?
  title                  String
  description            String?
  instructions           String?
  assessmentType         String               @default("quiz")
  duration               Int?
  passingScore           Float?
  maxAttempts            Int                  @default(1)
  shuffleQuestions       Boolean              @default(false)
  shuffleAnswers         Boolean              @default(false)
  showResultsImmediately Boolean              @default(false)
  allowReview            Boolean              @default(true)
  openAt                 DateTime?
  closeAt                DateTime?
  status                 String               @default("draft")
  publishedAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  classroom              Classroom?           @relation("ClassroomAssessments", fields: [classroomId], references: [id])
  org                    Organization?        @relation("OrgAssessments", fields: [orgId], references: [id], onDelete: Cascade)
  owner                  User                 @relation("UserAssessments", fields: [ownerId], references: [id], onDelete: Cascade)
  resource               Resource?            @relation("AssessmentResource", fields: [resourceId], references: [id])
  rubric                 Rubric?              @relation(fields: [rubricId], references: [id])
  attempts               AssessmentAttempt[]
  questions              AssessmentQuestion[]
  certificates           Certificate[]
  assignedWork           Assignment[]         @relation("AssignmentAssessment")

  @@index([ownerId])
  @@index([orgId])
  @@index([classroomId])
  @@index([resourceId])
  @@index([assessmentType])
  @@index([status])
}

model AssessmentQuestion {
