  dueAt        DateTime?
  dueDate      DateTime?
  visibility   String              @default("published")
  maxAttempts  Int                 @default(1)
  allowLate    Boolean             @default(true)
  points       Int                 @default(100)
  status       String              @default("active")
  publishedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  classroom    Classroom           @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  resource     Resource?           @relation("AssignmentResource", fields: [resourceId], references: [id], onDelete: SetNull)
  assessment   Assessment?         @relation("AssignmentAssessment", fields: [assessmentId], references: [id], onDelete: SetNull)
