  @@unique([assessmentId, questionId])
  @@index([assessmentId])
  @@index([questionId])
}

model AssessmentAttempt {
  id                      String               @id @default(cuid())
  assessmentId            String
  studentId               String
  status                  String               @default("in_progress")
  attemptNumber           Int                  @default(1)
