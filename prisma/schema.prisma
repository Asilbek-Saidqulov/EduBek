  coHostIds                 String            @default("[]")
  orgId                     String?
  classroomId               String?
  resourceId                String?
  assessmentId              String?
  gameMode                  String            @default("classic")
  config                    String            @default("{}")
  title                     String
  description               String?
  status                    String            @default("lobby")
  visibility                String            @default("private")
  maxPlayers                Int               @default(50)
  currentRound              Int               @default(0)
  totalRounds               Int               @default(10)
  leaderboardSnapshot       String            @default("{}")
  startedAt                 DateTime?
  finishedAt                DateTime?
  currentHostSocketId       String?
  archivedAt                DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
