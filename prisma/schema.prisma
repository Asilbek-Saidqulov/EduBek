model OrchestratorAIInvocation {
  id              String   @id @default(cuid())
  traceId         String
  promptId        String?
  promptVersion   Int?
  provider        String
  model           String
  input           String   
  output          String   
  status          String   @default("succeeded")
  userId          String?
  organizationId  String?
  tokensIn        Int      @default(0)
  tokensOut       Int      @default(0)
