  durationMs      Int      @default(0)
  cpuUsagePercent Float?
  memoryUsageMb   Float?
  // Error info
  errorMessage    String?
  errorStack      String?
  // Audit
  requestedBy     String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([extensionInstallId, status])
  @@index([status, startedAt])
  @@index([trigger])
}

model SandboxSession {
  id              String   @id @default(cuid())
  extensionInstallId String
  // Session status: 'active' | 'terminated' | 'expired'
  status          String   @default("active")
  // Resource limits
