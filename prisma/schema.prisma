generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String                       @id @default(cuid())
  email                String                       @unique
  emailVerified        DateTime?
  passwordHash         String?
  name                 String?
  username             String?                      @unique
  avatarUrl            String?
  primaryRole          String?                      @default("student")
  bio                  String?
  country              String?
  timezone             String?
  locale               String?                      @default("uz")
  phone                String?
  phoneVerified        DateTime?
  mfaSecretEncrypted   String?
  isBanned             Boolean                      @default(false)
  bannedReason         String?
  bannedUntil          DateTime?
  lastLoginAt          DateTime?
  lastLoginIpHash      String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  aiConversations      AiConversation[]
  aiDecisions          AiDecision[]                 @relation("UserAiDecisions")
  aiFeedback           AiFeedback[]
  aiSessions           AiSession[]                  @relation("UserAiSessions")
  aiUsageLogs          AiUsageLog[]                 @relation("UserAiUsageLogs")
  events               AnalyticsEvent[]
  assessments          Assessment[]                 @relation("UserAssessments")
  assessmentAttempts   AssessmentAttempt[]          @relation("UserAssessmentAttempts")
  assignmentAttempts   AssignmentAttempt[]          @relation("StudentAttempts")
  questions            BankQuestion[]               @relation("UserBankQuestions")
  questionVersions     BankQuestionVersion[]        @relation("UserBankQuestionVersions")
  certificatesIssued   Certificate[]                @relation("UserCertificatesIssued")
  certificates         Certificate[]                @relation("UserCertificates")
  classroomsAsTeacher  Classroom[]                  @relation("TeacherClassrooms")
  classroomsAsStudent  ClassroomStudent[]           @relation("StudentClassrooms")
  couponUsages         CouponUsage[]                @relation("UserCouponUsages")
  creatorProfile       Creator?
  creatorSubscriptions CreatorSubscription[]        @relation("CreatorSubSubscriber")
  funnelEvents         FunnelEvent[]                @relation("UserFunnelEvents")
  gameRewards          GameReward[]                 @relation("UserGameRewards")
  grades               GradebookEntry[]             @relation("UserGradebookEntries")
  invoicesOwned        Invoice[]                    @relation("UserInvoices")
  learningSessions     LearningSession[]            @relation("StudentLearningSessions")
  libraryItemsAdded    LibraryItem[]
  livePlayers          LivePlayer[]                 @relation("UserLivePlayers")
  liveSessionsHosted   LiveSession[]                @relation("HostedLiveSessions")
  marketplaceListings  MarketplaceListing[]         @relation("ListingSeller")
  marketplacePurchases MarketplacePurchase[]        @relation("PurchaseBuyer")
  marketplaceReviews   MarketplaceReview[]
  mpFavorites          MpFavorite[]                 @relation("UserMpFavorites")
  mpListings           MpListing[]                  @relation("UserMpListings")
  mpPurchases          MpPurchase[]                 @relation("UserMpPurchases")
  mpReviews            MpReview[]                   @relation("UserMpReviews")
  mpWishlist           MpWishlist[]                 @relation("UserMpWishlist")
  orgOwned             Organization[]               @relation("OrgOwner")
  orgInvitationsSent   OrganizationInvitation[]     @relation("OrgInvitationInviter")
  orgMemberships       OrganizationMembership[]
  plagiarismReports    PlagiarismReport[]           @relation("UserPlagiarismReports")
  proctoringIncidents  ProctoringIncident[]         @relation("UserProctoringIncidents")
  profile              Profile?
  progressRecords      ProgressRecord[]             @relation("StudentProgress")
  quizCreated          Quiz[]
  quizAttempts         QuizAttempt[]
  recommendations      Recommendation[]
  rubrics              Rubric[]                     @relation("UserRubrics")
  searchQueries        SearchQueryLog[]
  tournamentsHosted    Tournament[]                 @relation("HostedTournaments")
  transactionsAsBuyer  Transaction[]                @relation("TransactionBuyer")
  achievements         UserAchievement[]
  blockedBy            UserBlock[]                  @relation("UserBlocks_Blocked")
  blocks               UserBlock[]                  @relation("UserBlocks_Blocker")
  devices              UserDevice[]
  followedBy           UserFollow[]                 @relation("UserFollows_Followee")
  follows              UserFollow[]                 @relation("UserFollows_Follower")
  notifications        UserNotification[]
  notificationPrefs    UserNotificationPreference[]
  permissions          UserPermission[]
  userPreferences      UserPreferences?
  roles                UserRole[]
  sessions             UserSession[]
  streaks              UserStreak?
  userSubs             UserSubscription[]           @relation("UserUserSubscriptions")
  wallet               Wallet?

  @@index([email])
  @@index([username])
  @@index([isBanned])
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  displayName    String?
  level          Int      @default(1)
  xp             Int      @default(0)
  followersCount Int      @default(0)
  followingCount Int      @default(0)
  gamesCreated   Int      @default(0)
  gamesPlayed    Int      @default(0)
  accuracy       Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserRole {
  id        String    @id @default(cuid())
  userId    String
  role      String    @default("user")
  grantedBy String?
  grantedAt DateTime  @default(now())
  expiresAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

model UserPermission {
  id         String   @id @default(cuid())
  userId     String
  permission String
  granted    Boolean  @default(true)
  reason     String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  deviceId         String?
  userAgent        String?
  ipHash           String?
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  sessionTokenHash String?   @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionTokenHash])
  @@index([refreshTokenHash])
}

model UserDevice {
  id                String   @id @default(cuid())
  userId            String
  deviceFingerprint String   @unique
  name              String?
  platform          String?
  lastSeenAt        DateTime @default(now())
  isTrusted         Boolean  @default(false)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  data      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserNotificationPreference {
  id       String  @id @default(cuid())
  userId   String
  channel  String
  category String
  enabled  Boolean @default(true)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, category])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())
  metadata      String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model UserStreak {
  id              String    @id @default(cuid())
  userId          String    @unique
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastActivityDay DateTime?
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocked   User     @relation("UserBlocks_Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("UserBlocks_Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model UserFollow {
  id         String   @id @default(cuid())
  followerId String
  followeeId String
  createdAt  DateTime @default(now())
  followee   User     @relation("UserFollows_Followee", fields: [followeeId], references: [id], onDelete: Cascade)
  follower   User     @relation("UserFollows_Follower", fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId])
}

model Organization {
  id            String                   @id @default(cuid())
  name          String
  slug          String                   @unique
  type          String                   @default("school")
  ownerId       String
  billingEmail  String?
  country       String?
  plan          String                   @default("free")
  seats         Int                      @default(10)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  aiSessions    AiSession[]              @relation("OrgAiSessions")
  assessments   Assessment[]             @relation("OrgAssessments")
  questionBanks BankQuestion[]           @relation("OrgBankQuestions")
  classrooms    Classroom[]              @relation("OrgClassrooms")
  liveSessions  LiveSession[]            @relation("OrgLiveSessions")
  mpListings    MpListing[]              @relation("OrgMpListings")
  owner         User                     @relation("OrgOwner", fields: [ownerId], references: [id])
  billing       OrganizationBilling?
  cohorts       OrganizationCohort[]
  invitations   OrganizationInvitation[]
  memberships   OrganizationMembership[]
  roles         OrganizationRole[]
  quizzes       Quiz[]                   @relation("QuizOrg")
  rubrics       Rubric[]                 @relation("OrgRubrics")
  tournaments   Tournament[]             @relation("OrgTournaments")

  @@index([slug])
  @@index([ownerId])
}

model OrganizationRole {
  id          String       @id @default(cuid())
  orgId       String
  name        String
  permissions String
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId])
}

model OrganizationMembership {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  roleId    String?
  status    String       @default("active")
  joinedAt  DateTime     @default(now())
  expiresAt DateTime?
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model OrganizationInvitation {
  id          String       @id @default(cuid())
  orgId       String
  email       String
  roleId      String?
  token       String       @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())
  invitedBy   User         @relation("OrgInvitationInviter", fields: [invitedById], references: [id])
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
}

model OrganizationBilling {
  id               String       @id @default(cuid())
  orgId            String       @unique
  stripeCustomerId String?
  paymentMethodId  String?
  plan             String       @default("free")
  seats            Int          @default(10)
  renewalAt        DateTime?
  balance          Float        @default(0)
  updatedAt        DateTime     @updatedAt
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model OrganizationCohort {
  id          String                     @id @default(cuid())
  orgId       String
  name        String
  description String?
  createdById String?
  createdAt   DateTime                   @default(now())
  org         Organization               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members     OrganizationCohortMember[]
  quizCohorts QuizCohort[]

  @@index([orgId])
}

model OrganizationCohortMember {
  id       String             @id @default(cuid())
  cohortId String
  userId   String
  role     String             @default("student")
  joinedAt DateTime           @default(now())
  cohort   OrganizationCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
}

model MarketplaceCategory {
  id        String                @id @default(cuid())
  slug      String                @unique
  parentId  String?
  nameI18n  String
  sortOrder Int                   @default(0)
  createdAt DateTime              @default(now())
  parent    MarketplaceCategory?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  MarketplaceCategory[] @relation("CategoryParent")
  listings  MarketplaceListing[]

  @@index([parentId])
}

model MarketplaceListing {
  id               String                @id @default(cuid())
  sellerId         String
  contentType      String
  contentId        String
  title            String
  description      String?
  categoryId       String?
  priceEduTokens   Int                   @default(0)
  priceFiat        Float                 @default(0)
  currency         String                @default("USD")
  tier             String                @default("free")
  status           String                @default("draft")
  publishedAt      DateTime?
  reviewedAt       DateTime?
  reviewerId       String?
  rejectionReason  String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  libraryItems     LibraryItem[]
  category         MarketplaceCategory?  @relation(fields: [categoryId], references: [id])
  seller           User                  @relation("ListingSeller", fields: [sellerId], references: [id])
  prices           MarketplacePrice[]
  purchases        MarketplacePurchase[]
  reviews          MarketplaceReview[]
  transactionItems TransactionItem[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([contentType])
}

model MarketplacePrice {
  id             String                @id @default(cuid())
  listingId      String
  tier           String                @default("standard")
  priceEduTokens Int                   @default(0)
  priceFiat      Float                 @default(0)
  currency       String                @default("USD")
  validFrom      DateTime?
  validUntil     DateTime?
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  listing        MarketplaceListing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  purchases      MarketplacePurchase[]

  @@index([listingId])
}

model MarketplacePurchase {
  id              String              @id @default(cuid())
  buyerId         String
  listingId       String
  priceId         String?
  transactionId   String?
  amountPaid      Float               @default(0)
  currency        String              @default("USD")
  eduTokensSpent  Int                 @default(0)
  purchasedAt     DateTime            @default(now())
  refundableUntil DateTime?
  licenseType     String              @default("personal")
  buyer           User                @relation("PurchaseBuyer", fields: [buyerId], references: [id])
  listing         MarketplaceListing  @relation(fields: [listingId], references: [id])
  price           MarketplacePrice?   @relation(fields: [priceId], references: [id])
  refunds         MarketplaceRefund[]
  review          MarketplaceReview?

  @@index([buyerId])
  @@index([listingId])
}

model MarketplaceReview {
  id             String              @id @default(cuid())
  listingId      String
  buyerId        String
  purchaseId     String              @unique
  rating         Int
  title          String?
  body           String?
  sellerResponse String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  buyer          User                @relation(fields: [buyerId], references: [id])
  listing        MarketplaceListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  purchase       MarketplacePurchase @relation(fields: [purchaseId], references: [id])

  @@index([listingId])
  @@index([buyerId])
}

model MarketplaceRefund {
  id          String              @id @default(cuid())
  purchaseId  String
  amount      Float
  reason      String?
  initiatedBy String?
  processedAt DateTime?
  status      String              @default("pending")
  createdAt   DateTime            @default(now())
  purchase    MarketplacePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

model Creator {
  userId             String                         @id @unique
  displayName        String?
  bio                String?
  website            String?
  socialLinks        String?
  verificationStatus String                         @default("unverified")
  verifiedAt         DateTime?
  totalEarnings      Float                          @default(0)
  totalFollowers     Int                            @default(0)
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  user               User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  earnings           CreatorEarning[]
  payouts            CreatorPayout[]
  subscriptions      CreatorSubscription[]
  tiers              CreatorTier[]
  payoutAccounts     PayoutAccount[]
  platformTier       PlatformCreatorTierAssignment? @relation("CreatorPlatformTier")
}

model CreatorTier {
  id             String                @id @default(cuid())
  creatorId      String
  name           String
  priceEduTokens Int                   @default(0)
  priceFiat      Float                 @default(0)
  currency       String                @default("USD")
  benefits       String?
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  subscriptions  CreatorSubscription[]
  creator        Creator               @relation(fields: [creatorId], references: [userId], onDelete: Cascade)

  @@index([creatorId])
}

model CreatorSubscription {
  id            String       @id @default(cuid())
  subscriberId  String
  creatorId     String
  tierId        String?
  transactionId String?
  startedAt     DateTime     @default(now())
  endsAt        DateTime?
  status        String       @default("active")
  autoRenew     Boolean      @default(false)
  creator       Creator      @relation(fields: [creatorId], references: [userId], onDelete: Cascade)
  subscriber    User         @relation("CreatorSubSubscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  tier          CreatorTier? @relation(fields: [tierId], references: [id])

  @@index([subscriberId])
  @@index([creatorId])
}

model CreatorEarning {
  id          String   @id @default(cuid())
  creatorId   String
  source      String
  amount      Float    @default(0)
  currency    String   @default("USD")
  eduTokens   Int      @default(0)
  referenceId String?
  metadata    String?
  createdAt   DateTime @default(now())
  creator     Creator  @relation(fields: [creatorId], references: [userId], onDelete: Cascade)

  @@index([creatorId, createdAt])
}

model CreatorPayout {
  id               String         @id @default(cuid())
  creatorId        String
  amount           Float          @default(0)
  currency         String         @default("USD")
  payoutAccountId  String?
  status           String         @default("requested")
  requestedAt      DateTime       @default(now())
  processedAt      DateTime?
  stripeTransferId String?
  failureReason    String?
  creator          Creator        @relation(fields: [creatorId], references: [userId], onDelete: Cascade)
  payoutAccount    PayoutAccount? @relation(fields: [payoutAccountId], references: [id])

  @@index([creatorId])
}

model PayoutAccount {
  id                String          @id @default(cuid())
  creatorId         String
  provider          String
  externalAccountId String?
  country           String?
  isDefault         Boolean         @default(false)
  verifiedAt        DateTime?
  metadata          String?
  createdAt         DateTime        @default(now())
  payouts           CreatorPayout[]
  creator           Creator         @relation(fields: [creatorId], references: [userId], onDelete: Cascade)

  @@index([creatorId])
}

model Wallet {
  id               String           @id @default(cuid())
  userId           String           @unique
  eduTokensBalance Int              @default(0)
  fiatBalance      Float            @default(0)
  currency         String           @default("USD")
  lockedEduTokens  Int              @default(0)
  updatedAt        DateTime         @updatedAt
  ledgerEntries    EduTokenLedger[]
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EduTokenLedger {
  id            String   @id @default(cuid())
  walletId      String
  delta         Int
  balanceAfter  Int
  reason        String
  referenceType String?
  referenceId   String?
  metadata      String?
  createdAt     DateTime @default(now())
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model Transaction {
  id                    String              @id @default(cuid())
  buyerId               String
  sellerId              String?
  type                  String
  grossAmount           Float               @default(0)
  platformFee           Float               @default(0)
  sellerAmount          Float               @default(0)
  currency              String              @default("USD")
  eduTokensInvolved     Int                 @default(0)
  status                String              @default("pending")
  provider              String              @default("edu_tokens")
  providerTransactionId String?
  metadata              String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  escrow                Escrow?
  invoice               Invoice?
  buyer                 User                @relation("TransactionBuyer", fields: [buyerId], references: [id])
  items                 TransactionItem[]
  refunds               TransactionRefund[]
}

model TransactionItem {
  id            String              @id @default(cuid())
  transactionId String
  listingId     String?
  quantity      Int                 @default(1)
  unitPrice     Float               @default(0)
  totalPrice    Float               @default(0)
  eduTokens     Int                 @default(0)
  listing       MarketplaceListing? @relation(fields: [listingId], references: [id])
  transaction   Transaction         @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model TransactionRefund {
  id               String      @id @default(cuid())
  transactionId    String
  amount           Float       @default(0)
  reason           String?
  initiatedBy      String?
  providerRefundId String?
  status           String      @default("pending")
  createdAt        DateTime    @default(now())
  transaction      Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model Escrow {
  id            String      @id @default(cuid())
  transactionId String      @unique
  amount        Float       @default(0)
  status        String      @default("held")
  heldUntil     DateTime?
  releasedAt    DateTime?
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id                String                        @id @default(cuid())
  name              String
  tier              String                        @unique
  priceMonthly      Float                         @default(0)
  priceYearly       Float                         @default(0)
  currency          String                        @default("USD")
  features          String?
  aiCreditsMonthly  Int                           @default(0)
  isActive          Boolean                       @default(true)
  createdAt         DateTime                      @default(now())
  translations      SubscriptionPlanTranslation[] @relation("PlanTranslations")
  userSubscriptions UserSubscription[]
}

model UserSubscription {
  id                   String           @id @default(cuid())
  userId               String
  planId               String
  status               String           @default("active")
  startedAt            DateTime         @default(now())
  currentPeriodEnd     DateTime?
  autoRenew            Boolean          @default(false)
  stripeSubscriptionId String?
  cancelledAt          DateTime?
  plan                 SubscriptionPlan @relation(fields: [planId], references: [id])
  user                 User             @relation("UserUserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invoice {
  id            String       @id @default(cuid())
  userId        String
  transactionId String?      @unique
  number        String       @unique
  amount        Float        @default(0)
  currency      String       @default("USD")
  tax           Float        @default(0)
  pdfUrl        String?
  status        String       @default("draft")
  issuedAt      DateTime     @default(now())
  dueAt         DateTime?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  user          User         @relation("UserInvoices", fields: [userId], references: [id])

  @@index([userId])
}

model AiConversation {
  id             String       @id @default(cuid())
  userId         String
  orgId          String?
  title          String?
  contextSummary String?
  lastMessageAt  DateTime?
  isArchived     Boolean      @default(false)
  metadata       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisions      AiDecision[]
  messages       AiMessage[]
  session        AiSession?

  @@index([userId])
}

model AiMessage {
  id              String         @id @default(cuid())
  conversationId  String
  role            String
  content         String
  toolCalls       String?
  toolCallId      String?
  model           String?
  tokensIn        Int            @default(0)
  tokensOut       Int            @default(0)
  costUsd         Float          @default(0)
  latencyMs       Int?
  createdAt       DateTime       @default(now())
  feedback        AiFeedback[]
  conversation    AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolCallRecords AiToolCall[]

  @@index([conversationId, createdAt])
}

model AiContextMemory {
  id              String    @id @default(cuid())
  userId          String
  memoryType      String
  content         String
  confidence      Float     @default(0.5)
  sourceMessageId String?
  expiresAt       DateTime?
