/// AI prompt registry — one row per (promptId, version).
model OrchestratorPrompt {
  id               String   @id @default(cuid())
  promptId         String
  name             String
  description      String
  module           String
  version          Int
  versionTag       String
  template         String
  variables        String   @default("[]")
  providerOverride String?
  modelOverride    String?
  localizations    String   @default("[]")
  active           Boolean  @default(true)
  experimentId     String?
  evaluation       String?
  notes            String?
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([promptId, version])
  @@index([module, active])
  @@index([promptId, active])
}

/// In-progress or completed cross-system workflow executions.
model OrchestratorWorkflowExecution {
  id              String    @id @default(cuid())
  workflowId      String
  triggerEvent    String
  triggerPayload  String    @default("{}")
  status          String    @default("running")
  steps           String    @default("[]")
  traceId         String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  totalDurationMs Int?

  @@index([workflowId, status])
  @@index([status, startedAt])
  @@index([traceId])
}

/// AI invocations through the unified pipeline.
model OrchestratorAIInvocation {
  id             String   @id @default(cuid())
  traceId        String
  promptId       String?
  promptVersion  Int?
  provider       String
  model          String
  input          String
  output         String
  status         String   @default("succeeded")
  userId         String?
  organizationId String?
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  costUsd        Float    @default(0)
  latencyMs      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([traceId])
  @@index([provider, createdAt])
  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

/// Distributed trace spans across the whole platform.
model OrchestratorTraceSpan {
  id           String    @id @default(cuid())
  spanId       String
  parentSpanId String?
  traceId      String
  module       String
  operation    String
  status       String    @default("ok")
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  attributes   String    @default("{}")
  logs         String    @default("[]")

  @@index([traceId])
  @@index([module, startedAt])
  @@index([status, startedAt])
}

/// Self-healing actions executed by Platform Intelligence.
model OrchestratorHealingAction {
  id             String    @id @default(cuid())
  kind           String
  module         String
  triggerType    String
  triggerDetails String    @default("{}")
  status         String    @default("proposed")
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  resultSuccess  Boolean   @default(false)
  resultMessage  String
  resultDetails  String    @default("{}")
  autoExecuted   Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([module, status])
  @@index([status, createdAt])
  @@index([kind, createdAt])
}

/// Feature flags — runtime rollout control.
model OrchestratorFeatureFlag {
  key         String   @id
  description String   @default("")
  enabled     Boolean  @default(false)
  rollout     Int      @default(0)
  cohorts     String   @default("[]")
  updatedAt   DateTime @default(now()) @updatedAt
  createdAt   DateTime @default(now())

  @@index([enabled])
}

/// Circuit breakers — runtime state per protected operation.
model OrchestratorCircuitBreaker {
  name             String    @id
  module           String
  state            String    @default("closed")
  failureCount     Int       @default(0)
  failureThreshold Int       @default(5)
  lastFailureAt    DateTime?
  resetAt          DateTime?
  successCount     Int       @default(0)
  updatedAt        DateTime  @default(now()) @updatedAt
  createdAt        DateTime  @default(now())

  @@index([module, state])
}

/// Idempotency keys — prevents duplicate work on retries.
model OrchestratorIdempotencyKey {
  key             String   @id
  status          String   @default("pending")
  responseHash    String?
  responsePayload String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([status, expiresAt])
}

/// Distributed locks — short-lived, process-scoped.
model OrchestratorDistributedLock {
  id         String    @id @default(cuid())
  resource   String
  holder     String
  acquiredAt DateTime  @default(now())
  expiresAt  DateTime
  releasedAt DateTime?

  @@index([resource, expiresAt])
  @@index([holder])
}

/// Detected issues that may trigger self-healing.
model OrchestratorDetectedIssue {
  id           String    @id @default(cuid())
  module       String
  severity     String    @default("low")
  description  String
  detectedAt   DateTime  @default(now())
  autoHealable Boolean   @default(true)
  resolvedAt   DateTime?
  resolution   String?

  @@index([module, severity, detectedAt])
  @@index([resolvedAt])
}

/// Persistent user workspaces — restore on browser reopen.
model ProductWorkspace {
  id          String    @id @default(cuid())
  userId      String
  kind        String
  title       String
  tabs        String    @default("[]")
  history     String    @default("[]")
  undoStack   String    @default("[]")
  draft       String    @default("{}")
  active      Boolean   @default(false)
  autosavedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, active])
  @@index([userId, kind])
}

/// Journey states — current position in a multi-step flow.
model ProductJourney {
  id                        String    @id @default(cuid())
  userId                    String
  kind                      String
  title                     String
  currentStepIndex          Int       @default(0)
  steps                     String    @default("[]")
  suggestions               String    @default("[]")
  blockedSteps              String    @default("[]")
  completionPercent         Float     @default(0)
  estimatedRemainingMinutes Int       @default(0)
  status                    String    @default("active")
  startedAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  completedAt               DateTime?

  @@index([userId, status])
  @@index([userId, kind, status])
}

/// Attention items — things needing the user's focus.
model ProductAttentionItem {
  id              String    @id @default(cuid())
  userId          String
  kind            String
  title           String
  description     String
  priority        Float     @default(0)
  detectedAt      DateTime  @default(now())
  entityId        String?
  module          String?
  requiresAction  Boolean   @default(false)
  suggestedAction String?
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?

  @@index([userId, acknowledgedAt])
  @@index([userId, kind, detectedAt])
  @@index([priority])
}

/// User intents detected from natural-language queries.
model ProductIntent {
  id                 String   @id @default(cuid())
  userId             String
  query              String
  intent             String
  confidence         Float    @default(0)
  requiredSystems    String   @default("[]")
  requiredAgents     String   @default("[]")
  requiredWorkflows  String   @default("[]")
  recommendedActions String   @default("[]")
  detected           Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([userId, createdAt])
  @@index([intent])
}

/// Product memory entries — user preferences, layouts, behaviors.
model ProductMemory {
  id             String   @id @default(cuid())
  userId         String
  key            String
  value          String
  category       String
  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId, category])
}

/// Product analytics events — feature usage, navigation, friction.
model ProductAnalyticsEvent {
  id            String   @id @default(cuid())
  userId        String?
  eventType     String
  feature       String?
  location      String?
  metadata      String   @default("{}")
  frictionScore Float    @default(0)
  durationMs    Int?
  createdAt     DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

/// Notification clusters — grouped/deduplicated notifications.
model ProductNotificationCluster {
  id              String    @id @default(cuid())
  userId          String
  title           String
  body            String
  notificationIds String    @default("[]")
  priority        Float     @default(0)
  kind            String
  delivery        String    @default("now")
  deliverAt       DateTime  @default(now())
  count           Int       @default(1)
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, deliverAt])
  @@index([userId, deliveredAt])
}

/// Working memory — temporary context that expires automatically.
model CognitiveWorkingMemory {
  id         String   @id @default(cuid())
  scopeType  String
  scopeId    String
  kind       String
  payload    String   @default("{}")
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  accessedAt DateTime @default(now())

  @@index([scopeType, scopeId, expiresAt])
  @@index([expiresAt])
}

/// Episodic memory — important educational events.
model CognitiveEpisodicMemory {
  id             String   @id @default(cuid())
  scopeType      String
  scopeId        String
  kind           String
  summary        String
  payload        String   @default("{}")
  importance     Float    @default(0.5)
  linkedEntities String   @default("[]")
  tags           String   @default("[]")
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([scopeType, scopeId, occurredAt])
  @@index([kind, occurredAt])
  @@index([importance])
}

/// Semantic memory — generalized knowledge.
model CognitiveSemanticMemory {
  id             String   @id @default(cuid())
  domain         String
  kind           String
  statement      String
  explanation    String   @default("")
  source         String
  confidence     Float    @default(0.5)
  tags           String   @default("[]")
  createdAt      DateTime @default(now())
  lastAccessedAt DateTime @default(now())

  @@index([domain, kind])
  @@index([confidence])
}

/// Long-horizon plans.
model CognitivePlan {
  id                String   @id @default(cuid())
  objective         String
  nodes             String   @default("[]")
  dependencies      String   @default("[]")
  executionOrder    String   @default("[]")
  estimatedCost     Float    @default(0)
  estimatedDuration Float    @default(0)
  confidence        Float    @default(0.5)
  supportedGoals    String   @default("[]")
  status            String   @default("draft")
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, createdAt])
}

/// Cognitive goals.
model CognitiveGoal {
  id                  String   @id @default(cuid())
  kind                String
  title               String
  description         String   @default("")
  target              String   @default("{}")
  priority            Float    @default(50)
  conflictsWith       String   @default("[]")
  contributingModules String   @default("[]")
  progress            Float    @default(0)
  status              String   @default("active")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status, priority])
  @@index([kind, status])
}

/// Cognitive decisions — multi-option evaluations.
model CognitiveDecision {
  id             String   @id @default(cuid())
  title          String
  options        String   @default("[]")
  chosenOptionId String?
  rationale      String
  confidence     Float    @default(0.5)
  userId         String?
  organizationId String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

/// Reflections on AI actions.
model CognitiveReflection {
  id                      String   @id @default(cuid())
  actionType              String
  traceId                 String
  reflections             String   @default("[]")
  overallScore            Float    @default(0.5)
  lessons                 String   @default("[]")
  memoryUpdateRecommended Boolean  @default(false)
  createdAt               DateTime @default(now())

  @@index([traceId])
  @@index([actionType, createdAt])
  @@index([overallScore])
}

/// Conversation state across long conversations.
model CognitiveConversationState {
  id                    String   @id @default(cuid())
  userId                String
  objective             String?
  currentTask           String?
  entities              String   @default("[]")
  assumptions           String   @default("[]")
  pendingQuestions      String   @default("[]")
  followUpOpportunities String   @default("[]")
  lastMessageAt         DateTime @default(now())
  status                String   @default("active")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, status])
}

/// Cognitive analytics events — reasoning, tool usage, etc.
model CognitiveEvent {
  id         String   @id @default(cuid())
  eventType  String
  traceId    String?
  userId     String?
  module     String?
  payload    String   @default("{}")
  durationMs Int?
  confidence Float?
  llmInvoked Boolean  @default(false)
  costUsd    Float    @default(0)
  createdAt  DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([traceId])
  @@index([userId, createdAt])
}

/// Benchmark datasets — reusable evaluation question sets.
model AIQualityBenchmark {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  category    String
  questions   String   @default("[]")
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([version])
}

/// Evaluation results — deterministic metric scores per AI output.
model AIQualityEvaluation {
  id                     String   @id @default(cuid())
  benchmarkQuestionId    String
  provider               String
  model                  String
  promptId               String?
  promptVersion          Int?
  aiOutput               String
  metrics                String   @default("[]")
  overallScore           Float    @default(0)
  categoryScores         String   @default("{}")
  improvementSuggestions String   @default("[]")
  confidence             Float    @default(0.5)
  llmUsed                Boolean  @default(false)
  evaluationCost         Float    @default(0)
  createdAt              DateTime @default(now())

  @@index([provider, model, createdAt])
  @@index([promptId, promptVersion])
  @@index([benchmarkQuestionId])
}

/// Hallucination findings — detected issues in AI outputs.
model AIQualityHallucination {
  id                  String   @id @default(cuid())
  evaluationId        String?
  kind                String
  severity            String
  description         String
  flaggedText         String
  rationale           String
  suggestedCorrection String?
  createdAt           DateTime @default(now())

  @@index([severity, createdAt])
  @@index([kind, createdAt])
}

/// Citation validation results.
model AIQualityCitationCheck {
  id              String   @id @default(cuid())
  evaluationId    String?
  citation        String
  sourceExists    Boolean  @default(false)
  sourceReachable Boolean  @default(false)
  matchesClaim    Boolean  @default(false)
  isDuplicate     Boolean  @default(false)
  isBroken        Boolean  @default(false)
  details         String   @default("")
  createdAt       DateTime @default(now())

  @@index([evaluationId])
}

/// Managed datasets — versioned evaluation datasets with approval workflow.
model AIQualityDataset {
  id                  String   @id @default(cuid())
  name                String
  description         String   @default("")
  kind                String   @default("curated")
  category            String
  owner               String?
  currentVersion      Int      @default(1)
  versions            String   @default("[]")
  curriculumAlignment String   @default("[]")
  tags                String   @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([category])
  @@index([kind])
}

/// Quality scores — aggregated quality per provider/model/prompt.
model AIQualityScore {
  id          String   @id @default(cuid())
  provider    String
  model       String
  promptId    String?
  overall     Float    @default(0)
  dimensions  String   @default("[]")
  explanation String   @default("")
  grade       String   @default("F")
  createdAt   DateTime @default(now())

  @@index([provider, model])
  @@index([overall])
}

/// Leaderboard entries — best prompts/models/scores.
model AIQualityLeaderboard {
  id        String   @id @default(cuid())
  name      String
  type      String
  score     Float    @default(0)
  metric    String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([type, metric, score])
  @@index([metric, score])
}

/// AI experiments — A/B testing for prompts, models, routing, etc.
model AIObservabilityExperiment {
  id               String    @id @default(cuid())
  name             String
  type             String
  description      String    @default("")
  variants         String    @default("[]")
  status           String    @default("draft")
  successMetric    String    @default("quality")
  results          String?
  winnerVariant    String?
  winnerConfidence Float     @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, type])
}

/// AI anomalies — detected anomalies in AI behavior.
model AIObservabilityAnomaly {
  id                  String    @id @default(cuid())
  kind                String
  severity            String
  confidence          Float     @default(0.5)
  description         String
  rootCauseHypothesis String    @default("")
  affectedSystems     String    @default("[]")
  recommendedActions  String    @default("[]")
  resolvedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([severity, createdAt])
  @@index([kind, createdAt])
}

/// AI alerts — generated for operational events.
model AIObservabilityAlert {
  id                 String    @id @default(cuid())
  kind               String
  severity           String
  title              String
  description        String
  affectedSystems    String    @default("[]")
  recommendedActions String    @default("[]")
  acknowledgedAt     DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@index([severity, createdAt])
  @@index([kind, createdAt])
}

/// AI policies — hierarchical policy rules for AI usage.
model AIGovernancePolicy {
  id            String   @id @default(cuid())
  scope         String
  scopeId       String?
  name          String
  description   String   @default("")
  rules         String   @default("[]")
  inheritedFrom String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([scope, scopeId, status])
}

/// Approval requests — governance approval pipeline.
model AIGovernanceApproval {
  id             String    @id @default(cuid())
  type           String
  title          String
  description    String    @default("")
  requestedBy    String
  status         String    @default("draft")
  reviewedBy     String?
  reviewNotes    String?
  riskAssessment String?
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?

  @@index([status, type])
  @@index([requestedBy])
}

/// Governance audit entries — searchable audit trail.
model AIGovernanceAudit {
  id         String   @id @default(cuid())
  action     String
  actorType  String   @default("system")
  actorId    String?
  entityType String?
  entityId   String?
  scope      String   @default("platform")
  details    String   @default("{}")
  occurredAt DateTime @default(now())

  @@index([action, occurredAt])
  @@index([actorType, occurredAt])
  @@index([entityType, entityId])
}

/// Model governance registry — lifecycle tracking for AI models.
model AIGovernanceModel {
  id             String    @id @default(cuid())
  provider       String
  model          String
  status         String    @default("experimental")
  approvedAt     DateTime?
  approvedBy     String?
  qualityHistory String    @default("[]")
  latencyHistory String    @default("[]")
  costHistory    String    @default("[]")
  riskHistory    String    @default("[]")
  recommendation String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([provider, model])
  @@index([status])
}


