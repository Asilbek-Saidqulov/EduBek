  finishedAt      DateTime?
  durationMs      Int?
  attributes      String   @default("{}")
  logs           String   @default("[]")

  @@index([traceId])
  @@index([module, startedAt])
  @@index([status, startedAt])
}

/// Self-healing actions executed by Platform Intelligence.
model OrchestratorHealingAction {
  id              String   @id @default(cuid())
  kind            String
  module          String
  triggerType     String
  triggerDetails  String   @default("{}")
  status          String   @default("proposed")
  startedAt       DateTime?
  finishedAt      DateTime?
  durationMs      Int?
  resultSuccess   Boolean  @default(false)
  resultMessage   String
  resultDetails   String   @default("{}")
  autoExecuted    Boolean  @default(false)
