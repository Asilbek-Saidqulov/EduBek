// =============================================================================
// PHASE 5B.1 — ENTERPRISE INTEGRATION PLATFORM & OPEN EDUCATION ECOSYSTEM
// =============================================================================
// All models are ADDITIVE — no existing schema changes.

// ---------------------------------------------------------------------------
// Integration — a configured connector to an external system
// ---------------------------------------------------------------------------

model Integration {
  id              String   @id @default(cuid())
  // Connector type: 'google_classroom' | 'moodle' | 'canvas' | 'blackboard' | 'microsoft_teams' | 'zoom' | 'google_meet' | 'google_drive' | 'one_drive' | 'dropbox' | 'github' | 'gitlab' | 'ldap' | 'active_directory' | 'saml' | 'oauth2' | 'scim' | 'custom'
  type            String
  name            String
  description     String?
  // Organization that owns this integration
  organizationId  String?
  // Status: 'pending' | 'connected' | 'disconnected' | 'error' | 'paused'
  status          String   @default("pending")
  // JSON: { authMethod, credentials, scopes, config }
  config          String   @default("{}")
  // Last sync info
  lastSyncAt      DateTime?
  lastSyncStatus  String?  // 'success' | 'partial' | 'failed'
  lastSyncError   String?
  // Health check
  lastHealthCheckAt DateTime?
  healthStatus    String   @default("unknown")  // 'healthy' | 'degraded' | 'down' | 'unknown'
  // Sync schedule: 'manual' | 'hourly' | 'daily' | 'weekly'
  syncSchedule    String   @default("manual")
  // Whether webhooks are registered
  webhooksRegistered Boolean @default(false)
  // Enabled sync entities: JSON ['students', 'teachers', 'classrooms', 'enrollments', 'assignments', 'grades', 'attendance']
  syncEntities    String   @default("[]")
  // Field mapping: JSON { sourceField: targetField }
  fieldMapping    String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  syncLogs        IntegrationSyncLog[]

  @@index([organizationId, status])
  @@index([type, status])
  @@index([syncSchedule])
}

model IntegrationSyncLog {
  id              String   @id @default(cuid())
  integrationId   String
  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  // 'full' | 'incremental'
  syncType        String   @default("incremental")
  // 'success' | 'partial' | 'failed'
  status          String
  // Entities synced: JSON [{ entity, imported, updated, skipped, errors }]
  entities        String   @default("[]")
  // Conflicts detected: JSON [{ entity, localValue, remoteValue, resolution }]
  conflicts       String   @default("[]")
  // Total records processed
  totalProcessed  Int      @default(0)
  totalImported   Int      @default(0)
  totalUpdated    Int      @default(0)
  totalSkipped    Int      @default(0)
  totalErrors     Int      @default(0)
  // Duration in ms
  durationMs      Int      @default(0)
  errorMessage    String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([integrationId, startedAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Webhook Platform
// ---------------------------------------------------------------------------

model WebhookEndpoint {
  id              String   @id @default(cuid())
  ownerId         String
  organizationId  String?
  // URL to deliver webhooks to
  url             String
  // Events to subscribe to: JSON ['quiz.completed', 'assignment.submitted', ...]
  events          String   @default("[]")
  // HMAC signing secret
  secret          String   @default(cuid())
  // Status: 'active' | 'paused' | 'disabled'
  status          String   @default("active")
  // Retry config
  maxRetries      Int      @default(3)
  retryBackoffMs  Int      @default(5000)
  // Stats
  totalDelivered  Int      @default(0)
  totalFailed     Int      @default(0)
  lastDeliveryAt  DateTime?
  lastDeliveryStatus String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deliveries      WebhookDelivery[]

  @@index([ownerId])
  @@index([organizationId, status])
  @@index([status])
}

model WebhookDelivery {
  id              String   @id @default(cuid())
  endpointId      String
  endpoint        WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  // Event type
  eventType       String
  // Payload (JSON)
  payload         String   @default("{}")
  // Delivery status: 'pending' | 'delivered' | 'failed' | 'retrying'
  status          String   @default("pending")
  // HTTP response code
  responseCode    Int?
  // Response body (truncated)
  responseBody    String?
  // Attempt count
  attemptCount    Int      @default(0)
  // Next retry at
  nextRetryAt     DateTime?
  // Timestamps
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([endpointId, status])
  @@index([status, nextRetryAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// API Gateway — API keys + OAuth clients
// ---------------------------------------------------------------------------

model ApiKey {
  id              String   @id @default(cuid())
  ownerId         String
  organizationId  String?
  // Key prefix (first 8 chars) for identification; full key is hashed
  keyPrefix       String
  keyHash         String   @unique
