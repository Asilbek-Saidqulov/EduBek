model Extension {
  id              String   @id @default(cuid())
  // 'backend' | 'frontend' | 'workflow' | 'ai' | 'dashboard' | 'automation' | 'assessment' | 'knowledge_graph' | 'connector' | 'widget' | 'theme'
  type            String
  name            String
  slug            String   @unique
  description     String?
  developerId     String
  developerName   String
  // Latest version
  latestVersion   String   @default("1.0.0")
  // Status: 'draft' | 'submitted' | 'approved' | 'published' | 'rejected' | 'deprecated' | 'unlisted'
  status          String   @default("draft")
  // Pricing
  pricingModel    String   @default("free")
  priceEduTokens  Int      @default(0)
  // Categories + screenshots
  categories      String   @default("[]")
  screenshots     String   @default("[]")
  // Icon URL
  iconUrl         String?
  // Permissions requested
  permissions     String   @default("[]")
  // Hooks registered
  hooks           String   @default("[]")
  // UI extensions
  uiExtensions    String   @default("[]")
  // Config schema
  configSchema    String   @default("{}")
  // Stats
  installCount    Int      @default(0)
  ratingAverage   Float    @default(0)
  ratingCount     Int      @default(0)
  // Compatibility
