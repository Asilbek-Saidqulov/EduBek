  maxPlatformVersion String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions        ExtensionVersion[]
  installs        ExtensionInstall[]

  @@index([type, status])
  @@index([developerId])
  @@index([slug])
