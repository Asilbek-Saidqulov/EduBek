// =============================================================================
// 10. LIBRARY SYSTEM
// =============================================================================

model Library {
  id          String   @id @default(cuid())
  ownerType   String   @default("user") // 'user' | 'org'
  ownerId     String
  user        User?    @relation(fields: [ownerId], references: [id]) // when ownerType = 'user'
  org         Organization? @relation("OrgLibrary", fields: [ownerId], references: [id]) // when ownerType = 'org'
  name        String
  description String?
  visibility  String   @default("private") // 'private' | 'shared' | 'public'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       LibraryItem[]
  collections LibraryCollection[]
  access      LibraryAccess[]
  imports     LibraryImport[]

  @@index([ownerType, ownerId])
}

model LibraryItem {
  id         String   @id @default(cuid())
  libraryId  String
  library    Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  itemType   String   // 'quiz' | 'course' | 'listing'
  itemId     String
  addedById  String?
  addedBy    User?    @relation(fields: [addedById], references: [id])
  listingId  String?
  listing    MarketplaceListing? @relation(fields: [listingId], references: [id])
  metadata   String?  // JSON string
  addedAt    DateTime @default(now())

  collectionItems LibraryCollectionItem[]

  @@index([libraryId])
  @@unique([libraryId, itemType, itemId])
}

model LibraryCollection {
  id          String   @id @default(cuid())
  libraryId   String
  library     Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  items       LibraryCollectionItem[]

  @@index([libraryId])
}

model LibraryCollectionItem {
  id             String   @id @default(cuid())
  collectionId   String
  collection     LibraryCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  libraryItemId  String
  libraryItem    LibraryItem @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)
  orderNum       Int      @default(0)
  addedAt        DateTime @default(now())

  @@unique([collectionId, libraryItemId])
}

model LibraryAccess {
  id          String   @id @default(cuid())
  libraryId   String
  library     Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  granteeType String   // 'user' | 'org' | 'cohort'
  granteeId   String
  role        String   @default("viewer") // 'viewer' | 'editor'
  grantedBy   String?
  grantedAt   DateTime @default(now())

  @@unique([libraryId, granteeType, granteeId])
}

model LibraryImport {
  id            String    @id @default(cuid())
  libraryId     String
  library       Library   @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  source        String    // 'csv' | 'json' | 'moodle' | 'canvas'
  fileUrl       String?
  status        String    @default("queued") // 'queued' | 'processing' | 'completed' | 'failed'
  importedCount Int       @default(0)
  failedCount   Int       @default(0)
  errorLog      String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([libraryId])
}

// =============================================================================
// 11. CONTENT LIFECYCLE (cross-cutting)
// =============================================================================

model ContentVersion {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  version     Int
  snapshot    String   // JSON string
  changelog   String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId])
}

model ContentReview {
  id          String    @id @default(cuid())
  entityType  String
  entityId    String
  reviewerId  String?
  status      String    @default("pending") // 'pending' | 'approved' | 'rejected' | 'changes_requested'
  feedback    String?
  reviewedAt  DateTime?

  @@index([entityType, entityId])
}

model ContentModerationFlag {
  id          String    @id @default(cuid())
  entityType  String
  entityId    String
  flaggedBy   String?
  reason      String    // 'spam' | 'inappropriate' | 'copyright' | 'other'
  details     String?
  status      String    @default("open") // 'open' | 'reviewing' | 'resolved' | 'dismissed'
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([entityType, entityId])
}

// =============================================================================
// 18. Phase 3C — Coupons, Platform Creator Tiers, Growth
// =============================================================================

// Coupon / promotion engine
model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String?
  type            String    // 'percentage' | 'fixed' | 'free_purchase' | 'ai_credits'
  value           Float     @default(0) // percentage (0-100) or fixed amount or AI credits
  currency        String    @default("EDU")
  scope           String    @default("marketplace") // 'marketplace' | 'subscription' | 'ai' | 'platform'
  minPurchase     Int       @default(0)
  maxUsage        Int       @default(0) // 0 = unlimited
  maxUsagePerUser Int       @default(1)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  creatorOnly     Boolean   @default(false)
  firstPurchaseOnly Boolean @default(false)
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  usages CouponUsage[]

  @@index([code])
  @@index([scope, isActive])
}

model CouponUsage {
  id          String   @id @default(cuid())
  couponId    String
  coupon      Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("UserCouponUsages", fields: [userId], references: [id], onDelete: Cascade)
  orderId     String?  // reference to purchase or subscription
  discountAmount Float  @default(0)
  createdAt   DateTime @default(now())

  @@unique([couponId, userId, orderId])
  @@index([couponId])
  @@index([userId])
}

// Platform creator tiers (Starter, Silver, Gold, Elite) — separate from CreatorTier
// which is for creator-sold fan subscriptions
model PlatformCreatorTier {
  id              String   @id @default(cuid())
  name            String   @unique // 'starter' | 'silver' | 'gold' | 'elite' | 'verified' | 'partner'
  label           String   // display name
  revenueShare    Float    @default(90) // percentage creator keeps (e.g. 90 = 10% platform fee)
  payoutFrequency String   @default("monthly") // 'weekly' | 'biweekly' | 'monthly'
  badgeIcon       String?  // emoji or icon name
  featuredEligible Boolean @default(false)
  marketplacePriority Int  @default(0) // higher = more visible
  minEarnings     Float    @default(0) // threshold to qualify
  minSales        Int      @default(0)
  sortOrder       Int      @default(0)
  isSystem        Boolean  @default(true)
  createdAt       DateTime @default(now())

  assignments PlatformCreatorTierAssignment[]

  @@index([sortOrder])
}

model PlatformCreatorTierAssignment {
  id          String   @id @default(cuid())
  creatorId   String   @unique // one tier per creator
  creator     Creator  @relation("CreatorPlatformTier", fields: [creatorId], references: [userId], onDelete: Cascade)
  tierId      String
  tier        PlatformCreatorTier @relation(fields: [tierId], references: [id])
  assignedAt  DateTime @default(now())
  assignedBy  String?
  metadata    String?  // JSON string

  @@index([tierId])
}

// =============================================================================
// 19. AUDIT LOG (cross-cutting — Phase R0)
// =============================================================================
// Append-only audit trail. Every domain event is mirrored here by the audit
// listeners (see src/infra/listeners/audit-listeners.ts) so that compliance,
// forensic, and analytics pipelines can replay the platform's history without
// touching the live event bus.

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorType   String?  @default("user") // 'user' | 'system' | 'api'
  action      String   // e.g. 'user.registered', 'org.created', 'listing.published'
  entityType  String?  // 'user' | 'organization' | 'listing' | 'resource' | ...
  entityId    String?
  status      String?  // 'success' | 'failure' | 'pending'
  metadata    String?  // JSON string — opaque payload
  ipAddress   String?
  userAgent   String?
  occurredAt  DateTime @default(now())

  @@index([actorId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([action, occurredAt])
}

// =============================================================================
// 20. RESOURCE LIBRARY (Phase R1)
// =============================================================================
// Top-level educational resources (quizzes, worksheets, lesson plans, etc.)
// that a user owns personally or that belong to an organization. Resources
// carry versioned content snapshots, tags, favorites, stats, and may be
// grouped into Collections and shared via ShareLinks.

model Resource {
  id              String   @id @default(cuid())
  ownerType       String   @default("user") // 'user' | 'org'
  ownerId         String
  orgId           String?
  resourceType    String   // 'quiz' | 'worksheet' | 'lesson_plan' | 'presentation' | 'flashcards' | 'notes' | 'exam' | 'homework' | 'practice_material'
  title           String
  description     String?
  subject         String?
  grade           String?
  language        String   @default("uz")
  visibility      String   @default("private") // 'private' | 'org' | 'public'
  status          String   @default("ready") // 'draft' | 'ready' | 'archived'
  coverUrl        String?
  content         String   @default("{}") // JSON-serialized content payload (current state)
  metadata        String   @default("{}") // JSON-serialized metadata
  durationMinutes Int?
  duplicatedFromId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tags            ResourceTag[]
  versions        ResourceVersion[]
  favorites       ResourceFavorite[]
  stats           ResourceStat?
  shares          SharedResource[]
  mpListing                      MpListing?                    @relation("MpListingResource")
  mpPurchaseResource             MpPurchase?                   @relation("MpPurchaseResource")
  aiSessions                     AiSession[]                   @relation("AiSessionCurrentResource")
  assignments                    Assignment[]                  @relation("AssignmentResource")
  attemptResourceCopies          AssignmentAttempt[]           @relation("AttemptResourceCopy")
  learningSessionResources       LearningSession[]             @relation("LearningSessionResource")
  assessments                    Assessment[]                  @relation("AssessmentResource")
  liveSessions                   LiveSession[]                 @relation("LiveSessionResource")
  collectionItems CollectionItem[]
  // Phase 4E.5: multilingual translations
  translations   ResourceTranslation[] @relation("ResourceTranslations")

  @@index([ownerType, ownerId])
  @@index([orgId])
  @@index([resourceType])
  @@index([subject])
  @@index([grade])
  @@index([visibility])
  @@index([status])
  @@index([duplicatedFromId])
  @@index([updatedAt])
}

model ResourceVersion {
  id          String   @id @default(cuid())
  resourceId  String
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    String   // JSON-serialized full content snapshot
  changelog   String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([resourceId, version])
  @@index([resourceId, version])
}

model ResourceTag {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag        String   // lowercased
  createdAt  DateTime @default(now())

  @@unique([resourceId, tag])
  @@index([tag])
}

model ResourceFavorite {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  createdAt  DateTime @default(now())

  @@unique([resourceId, userId])
  @@index([userId])
}

model OrganizationResourceCategory {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  slug      String
  parentId  String?
  createdAt DateTime @default(now())

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([parentId])
}

model Collection {
  id          String   @id @default(cuid())
  ownerType   String   @default("user") // 'user' | 'org'
  ownerId     String
  orgId       String?
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       CollectionItem[]

  @@index([ownerType, ownerId])
  @@index([orgId])
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  resourceId   String
  resource     Resource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  sortOrder    Int      @default(0)
  addedAt      DateTime @default(now())

  @@unique([collectionId, resourceId])
  @@index([collectionId])
  @@index([resourceId])
}

model ResourceStat {
  id              String   @id @default(cuid())
  resourceId      String   @unique
  resource        Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  viewCount       Int      @default(0)
  duplicateCount  Int      @default(0)
  favoriteCount   Int      @default(0)
  lastOpenedAt    DateTime?
  lastEditedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SharedResource {
  id          String    @id @default(cuid())
  resourceId  String
  resource    Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  token       String    @unique
  createdById String
  expiresAt   DateTime?
  revokedAt   DateTime?
  viewCount   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([resourceId])
  @@index([createdById])
}

// =============================================================================
// AiSession (Phase 2C) — AI workspace container
// =============================================================================

model AiSession {
  id                String    @id @default(cuid())
  ownerId           String
  owner             User      @relation("UserAiSessions", fields: [ownerId], references: [id], onDelete: Cascade)
  orgId             String?
  org               Organization? @relation("OrgAiSessions", fields: [orgId], references: [id], onDelete: Cascade)
  conversationId    String?   @unique
  conversation      AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  title             String    @default("New AI Session")
  currentResourceId String?
  currentResource   Resource? @relation("AiSessionCurrentResource", fields: [currentResourceId], references: [id], onDelete: SetNull)
  currentModel      String    @default("zai-default")
  currentPromptTemplate String?
  status            String    @default("active")
  metadata          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  archivedAt        DateTime?

  @@index([ownerId])
  @@index([orgId])
  @@index([status])
}

// =============================================================================
// Marketplace (Phase 3A) — Listings, Categories, Favorites, Collections
// =============================================================================

model MpListing {
  id                    String    @id @default(cuid())
  resourceId            String    @unique
  resource              Resource  @relation("MpListingResource", fields: [resourceId], references: [id], onDelete: Cascade)
  creatorId             String
  creator               User      @relation("UserMpListings", fields: [creatorId], references: [id], onDelete: Cascade)
  orgId                 String?
  org                   Organization? @relation("OrgMpListings", fields: [orgId], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  thumbnailUrl          String?
  estimatedDuration     String?
  difficulty            String?
  price                 Float     @default(0)
  currency              String    @default("USD")
  licenseType           String    @default("personal")
  status                String    @default("draft")
  visibility            String    @default("marketplace")
  featured              Boolean   @default(false)
  resourceVersionPublished Int?
  viewCount             Int       @default(0)
  favoriteCount         Int       @default(0)
  downloadCount         Int       @default(0)
  ratingAverage         Float     @default(0)
  ratingCount           Int       @default(0)
  publishedAt           DateTime?
  unpublishedAt         DateTime?
  submittedAt           DateTime?
  approvedAt            DateTime?
  approvedById          String?
  archivedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  categories            MpListingCategory[]
  favorites             MpFavorite[]
  purchases             MpPurchase[]
  reviews               MpReview[]
  wishlist              MpWishlist[]

  @@index([creatorId])
  @@index([orgId])
  @@index([status])
  @@index([featured, status])
}

model MpCategory {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  listings    MpListingCategory[]
  // Phase 4E.5: multilingual translations
  translations CategoryTranslation[] @relation("CategoryTranslations")
  @@index([slug])
}

model MpListingCategory {
  id          String     @id @default(cuid())
  listingId   String
  listing     MpListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  categoryId  String
  category    MpCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  @@unique([listingId, categoryId])
  @@index([listingId])
  @@index([categoryId])
}

model MpFavorite {
  id          String    @id @default(cuid())
  listingId   String
  listing     MpListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("UserMpFavorites", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  @@unique([listingId, userId])
  @@index([userId])
}

model MpPurchase {
  id              String    @id @default(cuid())
  buyerId         String
  buyer           User      @relation("UserMpPurchases", fields: [buyerId], references: [id], onDelete: Cascade)
  listingId       String
  listing         MpListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  creatorId       String
  resourceId      String    @unique
  resource        Resource  @relation("MpPurchaseResource", fields: [resourceId], references: [id], onDelete: Cascade)
  pricePaid       Int       @default(0)
  platformFee     Int       @default(0)
  creatorEarning  Int       @default(0)
  status          String    @default("completed")
  refundableUntil DateTime?
  refundedAt      DateTime?
  createdAt       DateTime  @default(now())
  review          MpReview?
  @@unique([buyerId, listingId])
  @@index([buyerId])
  @@index([listingId])
  @@index([creatorId])
}

model MpReview {
  id          String     @id @default(cuid())
  listingId   String
  listing     MpListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User       @relation("UserMpReviews", fields: [buyerId], references: [id], onDelete: Cascade)
  purchaseId  String     @unique
  purchase    MpPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  rating      Int
  title       String?
  body        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  @@index([listingId])
  @@index([buyerId])
}

model MpWishlist {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("UserMpWishlist", fields: [userId], references: [id], onDelete: Cascade)
  listingId   String
  listing     MpListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  @@unique([userId, listingId])
  @@index([userId])
}

// =============================================================================
// Phase 3C — Coupons, Platform Creator Tiers
// =============================================================================









// =============================================================================
// Phase 4A — Student Learning Platform & Assignment System
// =============================================================================

model Classroom {
  id          String   @id @default(cuid())
  name        String
  description String?
  teacherId   String
  teacher     User     @relation("TeacherClassrooms", fields: [teacherId], references: [id], onDelete: Cascade)
  orgId       String?
  org         Organization? @relation("OrgClassrooms", fields: [orgId], references: [id], onDelete: Cascade)
  status      String   @default("active") // 'active' | 'archived'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students    ClassroomStudent[]
  assignments Assignment[]
  assessments Assessment[]    @relation("ClassroomAssessments")
  certificates Certificate[]  @relation("ClassroomCertificates")
  liveSessions LiveSession[]  @relation("ClassroomLiveSessions")

  @@index([teacherId])
  @@index([orgId])
  @@index([status])
}

model ClassroomStudent {
  id          String   @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId   String
  student     User      @relation("StudentClassrooms", fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())
  status      String    @default("active") // 'active' | 'removed'

  @@unique([classroomId, studentId])
  @@index([studentId])
}

model Assignment {
  id           String   @id @default(cuid())
  classroomId  String
  classroom    Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  resourceId   String
  resource     Resource  @relation("AssignmentResource", fields: [resourceId], references: [id], onDelete: Cascade)
  teacherId    String
  title        String
  instructions String?
  dueDate      DateTime?
  visibility   String   @default("published") // 'draft' | 'published' | 'archived'
  maxAttempts  Int      @default(1)
  allowLate    Boolean  @default(true)
  points       Int      @default(100)
  status       String   @default("active")
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attempts     AssignmentAttempt[]

  @@index([classroomId])
  @@index([teacherId])
  @@index([resourceId])
  @@index([visibility, status])
}

model AssignmentAttempt {
  id             String   @id @default(cuid())
  assignmentId   String
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId      String
  student        User     @relation("StudentAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  resourceCopyId String   @unique
  resourceCopy   Resource @relation("AttemptResourceCopy", fields: [resourceCopyId], references: [id], onDelete: Cascade)
  status         String   @default("not_started") // 'not_started' | 'in_progress' | 'submitted' | 'graded' | 'returned'
  attemptNumber  Int      @default(1)
  startedAt      DateTime?
  submittedAt    DateTime?
  gradedAt       DateTime?
  score          Int?
  maxScore       Int      @default(100)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submission     Submission?
  learningSessions LearningSession[]

  @@unique([assignmentId, studentId, attemptNumber])
  @@index([studentId])
  @@index([assignmentId])
  @@index([status])
}

model Submission {
  id          String   @id @default(cuid())
  attemptId   String   @unique
  attempt     AssignmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  studentId   String
  content     String?  // JSON string — student's work / answers
  feedback    String?
  status      String   @default("draft") // 'draft' | 'submitted' | 'returned' | 'resubmitted' | 'graded'
  attachments String?  // JSON array
  submittedAt DateTime?
  returnedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grade       Grade?

  @@index([studentId])
  @@index([status])
}

model Grade {
  id           String   @id @default(cuid())
  submissionId String   @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  teacherId    String
  points       Int
  maxPoints    Int      @default(100)
  rubric       String?  // JSON string
  feedback     String?
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([teacherId])
}

model LearningSession {
  id           String   @id @default(cuid())
  studentId    String
  student      User     @relation("StudentLearningSessions", fields: [studentId], references: [id], onDelete: Cascade)
  attemptId    String?
  attempt      AssignmentAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  resourceId   String?
  resource     Resource? @relation("LearningSessionResource", fields: [resourceId], references: [id], onDelete: SetNull)
  status       String   @default("active") // 'active' | 'paused' | 'completed'
  durationMs   Int      @default(0)
  interactions Int      @default(0)
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  updatedAt    DateTime @updatedAt

  @@index([studentId])
  @@index([attemptId])
  @@index([status])
}

model ProgressRecord {
  id              String   @id @default(cuid())
  studentId       String
  student         User     @relation("StudentProgress", fields: [studentId], references: [id], onDelete: Cascade)
  classroomId     String?
  assignmentId    String?
  metric          String   // 'assignment_completed' | 'score' | 'time_spent' | 'resource_viewed' | 'streak'
  value           Float    @default(0)
  metadata        String?  // JSON string
  createdAt       DateTime @default(now())

  @@index([studentId])
  @@index([classroomId])
  @@index([assignmentId])
  @@index([metric, createdAt])
}

// =============================================================================
// PHASE 4B — ASSESSMENT ENGINE, EXAMINATIONS & CERTIFICATION
// =============================================================================
//
// Models added in this phase:
//   • Question / QuestionVersion     — reusable question bank items
//   • Assessment                     — a test/quiz/exam container
//   • AssessmentQuestion             — joins questions into an assessment
//   • AssessmentAttempt              — a student's attempt at an assessment
//   • AssessmentResponse             — per-question answer within an attempt
//   • Rubric / RubricCriterion       — reusable grading rubrics
//   • GradebookEntry                 — flattened gradebook row per (student, source)
//   • Certificate                    — immutable certificate of completion
//   • ProctoringIncident             — lightweight integrity tracking
//   • PlagiarismReport               — similarity check results (interface only)
//
// Design rules:
//   • Assessments reference Resources (no duplication of resource model).
//   • Every state transition publishes a domain event (see events.ts).
//   • GradebookEntry is a denormalized read model — services keep it in sync.
//   • Certificates are immutable: revoke = set `revokedAt`, never delete.
// =============================================================================

// -----------------------------------------------------------------------------
// Question Bank
// -----------------------------------------------------------------------------

model BankQuestion {
  id              String   @id @default(cuid())
  ownerId         String
  owner           User     @relation("UserBankQuestions", fields: [ownerId], references: [id], onDelete: Cascade)
  orgId           String?
  org             Organization? @relation("OrgBankQuestions", fields: [orgId], references: [id], onDelete: Cascade)
  questionType    String   // 'multiple_choice' | 'multiple_select' | 'true_false' | 'short_answer' | 'essay' | 'matching' | 'ordering' | 'fill_blank'
  // Latest snapshot — JSON payload with prompt, options, answer key, etc.
  payload         String   @default("{}")
  subject         String?
  grade           String?
  difficulty      String   @default("medium") // 'easy' | 'medium' | 'hard'
  topic           String?
  estimatedTime   Int?     // seconds
  learningObjective String?
  points          Int      @default(1)
  status          String   @default("active") // 'active' | 'archived'
  versionNumber   Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions        BankQuestionVersion[]
  assessmentLinks AssessmentQuestion[]
  liveRounds      LiveRound[]              @relation("LiveRoundQuestion")
  aiGeneratedFrom String?  // AI session id that produced this question

  @@index([ownerId])
  @@index([orgId])
  @@index([questionType])
  @@index([subject])
  @@index([difficulty])
  @@index([status])
}

model BankQuestionVersion {
  id          String   @id @default(cuid())
  questionId  String
  question    BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    String   // JSON-serialized full content snapshot
  changelog   String?
  createdById String?
  createdBy   User?    @relation("UserBankQuestionVersions", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([questionId, version])
  @@index([questionId, version])
}

// -----------------------------------------------------------------------------
// Rubrics
// -----------------------------------------------------------------------------

model Rubric {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation("UserRubrics", fields: [ownerId], references: [id], onDelete: Cascade)
  orgId       String?
  org         Organization? @relation("OrgRubrics", fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  maxPoints   Int      @default(100)
  status      String   @default("active") // 'active' | 'archived'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  criteria    RubricCriterion[]
  assessments Assessment[]

  @@index([ownerId])
  @@index([orgId])
  @@index([status])
}

model RubricCriterion {
  id          String   @id @default(cuid())
  rubricId    String
  rubric      Rubric   @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  name        String
  description String?
  maxPoints   Int      @default(10)
  // JSON array of { points, label, description } levels
  levels      String   @default("[]")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([rubricId])
}

// -----------------------------------------------------------------------------
// Assessment
// -----------------------------------------------------------------------------

model Assessment {
  id                  String   @id @default(cuid())
  ownerId             String
  owner               User     @relation("UserAssessments", fields: [ownerId], references: [id], onDelete: Cascade)
  orgId               String?
  org                 Organization? @relation("OrgAssessments", fields: [orgId], references: [id], onDelete: Cascade)
  classroomId         String?
  classroom           Classroom? @relation("ClassroomAssessments", fields: [classroomId], references: [id], onDelete: SetNull)
  resourceId          String?
  resource            Resource? @relation("AssessmentResource", fields: [resourceId], references: [id], onDelete: SetNull)
  assignmentId        String?
  rubricId            String?
  rubric              Rubric?  @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  title               String
  description         String?
  instructions        String?
  // Assessment type: 'quiz' (untimed) | 'exam' (timed, locked) | 'practice' (open)
  assessmentType      String   @default("quiz") // 'quiz' | 'exam' | 'practice'
  duration            Int?     // seconds; null = no time limit
  passingScore        Float?   // percentage 0-100
  maxAttempts         Int      @default(1)
  shuffleQuestions    Boolean  @default(false)
  shuffleAnswers      Boolean  @default(false)
  showResultsImmediately Boolean @default(false)
  allowReview         Boolean  @default(true)
  openAt              DateTime?
  closeAt             DateTime?
  status              String   @default("draft") // 'draft' | 'published' | 'archived'
  publishedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  questions           AssessmentQuestion[]
  attempts            AssessmentAttempt[]
  certificates        Certificate[]

  @@index([ownerId])
  @@index([orgId])
  @@index([classroomId])
  @@index([resourceId])
  @@index([assessmentType])
  @@index([status])
}

model AssessmentQuestion {
  id            String   @id @default(cuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId    String
  question      BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order         Int      @default(0)
  points        Int      @default(1)
  // Optional per-assessment overrides (JSON: prompt override, hint, etc.)
  overrides     String?  // JSON
  createdAt     DateTime @default(now())

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
  @@index([questionId])
}

// -----------------------------------------------------------------------------
// Assessment Attempt & Responses
// -----------------------------------------------------------------------------

model AssessmentAttempt {
  id              String   @id @default(cuid())
  assessmentId    String
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId       String
  student         User     @relation("UserAssessmentAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  status          String   @default("in_progress") // 'in_progress' | 'submitted' | 'graded' | 'expired' | 'paused'
  attemptNumber   Int      @default(1)
  startedAt       DateTime @default(now())
  submittedAt     DateTime?
  gradedAt        DateTime?
  expiresAt       DateTime?  // for timed exams
  pausedAt        DateTime?
  resumedAt       DateTime?
  timeRemainingMs Int?     // snapshot of remaining time when paused
  score           Float?   // percentage 0-100
  pointsAwarded   Int?
  pointsMax       Int      @default(0)
  passed          Boolean?
  // Shuffle order snapshot (JSON array of question ids in display order)
  questionOrder   String?
  // Auto vs manual grading split
  autoGradedAt    DateTime?
  manualGradedAt  DateTime?
  // Proctoring summary
  proctoringIncidentCount Int @default(0)
  proctoringFlagged Boolean @default(false)
  plagiarismScore Float?  // 0-100
  plagiarismFlagged Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  responses       AssessmentResponse[]
  proctoringIncidents ProctoringIncident[]
  plagiarismReports   PlagiarismReport[]
  gradebookEntry       GradebookEntry?

  @@unique([assessmentId, studentId, attemptNumber])
  @@index([assessmentId])
  @@index([studentId])
  @@index([status])
  @@index([expiresAt])
}

model AssessmentResponse {
  id              String   @id @default(cuid())
  attemptId       String
  attempt         AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId      String
  questionType    String
  // JSON: the student's answer (varies by question type)
  answer          String?
  // Per-response grading
  pointsAwarded   Int?
  pointsMax       Int      @default(1)
  isCorrect       Boolean?
  gradedBy        String?  // 'auto' | userId
  gradedAt        DateTime?
  feedback        String?
  // Time spent on this question (ms)
  timeSpentMs     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

// -----------------------------------------------------------------------------
// Gradebook (denormalized read model)
// -----------------------------------------------------------------------------

model GradebookEntry {
  id              String   @id @default(cuid())
  classroomId     String?
  studentId       String
  student         User     @relation("UserGradebookEntries", fields: [studentId], references: [id], onDelete: Cascade)
  sourceType      String   // 'assignment' | 'assessment' | 'exam'
  sourceId        String   // assignmentId or assessmentId
  attemptId       String?  // assignment attempt or assessment attempt
  assessmentAttemptId String? @unique
  assessmentAttempt AssessmentAttempt? @relation(fields: [assessmentAttemptId], references: [id], onDelete: SetNull)
  title           String
  points          Float?
  maxPoints       Float    @default(100)
  percentage      Float?
  passed          Boolean?
  gradedAt        DateTime?
  // JSON: rubric breakdown, comments, etc.
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([classroomId])
  @@index([studentId])
  @@index([sourceType, sourceId])
  @@index([gradedAt])
}

// -----------------------------------------------------------------------------
// Certificates (immutable)
// -----------------------------------------------------------------------------

model Certificate {
  id              String   @id @default(cuid())
  // Verification code — public, used by /api/certificates/verify/[code]
  verificationCode String  @unique
  // Human-readable certificate number (e.g. EDUBEK-2026-00001)
  certificateNumber String @unique
  studentId       String
  student         User     @relation("UserCertificates", fields: [studentId], references: [id], onDelete: Cascade)
  issuedById      String
  issuedBy        User     @relation("UserCertificatesIssued", fields: [issuedById], references: [id])
  classroomId     String?
  classroom       Classroom? @relation("ClassroomCertificates", fields: [classroomId], references: [id], onDelete: SetNull)
  assessmentId    String?
  assessment      Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  resourceId      String?
  // Certificate type: 'assessment' | 'course' | 'achievement'
  certificateType String   @default("assessment")
  title           String
  description     String?
  studentName     String
  issuerName      String
  courseName      String?
  score           Float?
  maxScore        Float?
  issuedAt        DateTime @default(now())
  // Immutable after issue — revoke sets revokedAt + revokedReason, never deletes
  revokedAt       DateTime?
  revokedReason   String?
  revokedById     String?
  // PDF (base64) cached on first generation
  pdfBase64       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([studentId])
  @@index([classroomId])
  @@index([assessmentId])
  @@index([verificationCode])
  @@index([issuedAt])
}

// -----------------------------------------------------------------------------
// Proctoring (lightweight incident tracking — no webcam)
// -----------------------------------------------------------------------------

model ProctoringIncident {
  id              String   @id @default(cuid())
  attemptId       String
  attempt         AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  studentId       String
  student         User     @relation("UserProctoringIncidents", fields: [studentId], references: [id], onDelete: Cascade)
  // Incident types: 'tab_switch' | 'fullscreen_exit' | 'disconnect' | 'copy' | 'paste' | 'multiple_devices' | 'window_blur'
  incidentType    String
  severity        String   @default("info") // 'info' | 'warning' | 'critical'
  description     String?
  // Client-side metadata (JSON): timestamp offset, page url, etc.
  metadata        String?
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([attemptId])
  @@index([studentId])
  @@index([incidentType])
  @@index([occurredAt])
}

// -----------------------------------------------------------------------------
// Plagiarism (interface-only — no external provider integration yet)
// -----------------------------------------------------------------------------

model PlagiarismReport {
  id              String   @id @default(cuid())
  attemptId       String
  attempt         AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  studentId       String
  student         User     @relation("UserPlagiarismReports", fields: [studentId], references: [id], onDelete: Cascade)
  // The submission that was compared
  sourceResponseId String?
  // The submission(s) we compared against (JSON array of response ids)
  comparedWith    String   @default("[]")
  // 0-100 similarity score
  similarityScore Float    @default(0)
  // Threshold at the time of comparison (0-100)
  threshold       Float    @default(60)
  flagged         Boolean  @default(false)
  // JSON: per-pair breakdown of similarity
  details         String?
  provider        String   @default("internal") // 'internal' | future: 'turnitin' | 'copyleaks'
  status          String   @default("completed") // 'pending' | 'completed' | 'failed'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([attemptId])
  @@index([studentId])
  @@index([flagged])
}


// =============================================================================
// PHASE 4C — LIVE QUIZ ENGINE, REAL-TIME MULTIPLAYER & GAMIFIED LEARNING
// =============================================================================
//
// Models added in this phase:
//   • LiveSession / LivePlayer / LiveRound / LiveAnswer  — core engine state
//   • LiveLeaderboard                                       — leaderboard snapshots
//   • Lobby                                                  — pre-game lobby
//   • Replay                                                 — full session history
//   • Tournament / TournamentMatch                           — bracket system
//   • GameReward                                             — XP/coins/achievements
//
// Design rules:
//   • LiveSession is the central entity — every round, answer, leaderboard
//     entry, and reward references it.
//   • Question synchronization is stateless: the host advances rounds;
//     clients receive round payloads via Socket.IO and POST their answers
//     back. The server is the single source of truth for scoring.
//   • Replays are append-only event logs — the ReplayEvent table stores
//     every state transition in chronological order.
//   • Tournaments are bracket trees: TournamentMatch references two
//     LiveSessions (or one for byes).
// =============================================================================

// -----------------------------------------------------------------------------
// LiveSession — the engine's central entity
// -----------------------------------------------------------------------------

model LiveSession {
  id              String   @id @default(cuid())
  code            String   @unique @default(cuid()) // short join code (also stored on Lobby)
  hostId          String
  host            User     @relation("HostedLiveSessions", fields: [hostId], references: [id], onDelete: Cascade)
  coHostIds       String   @default("[]") // JSON array of userIds
  orgId           String?
  org             Organization? @relation("OrgLiveSessions", fields: [orgId], references: [id], onDelete: Cascade)
  classroomId     String?
  classroom       Classroom? @relation("ClassroomLiveSessions", fields: [classroomId], references: [id], onDelete: SetNull)
  resourceId      String?
  resource        Resource? @relation("LiveSessionResource", fields: [resourceId], references: [id], onDelete: SetNull)
  assessmentId    String?
  // The game mode strategy identifier (e.g. 'classic', 'treasure', 'empire', 'royale', 'battle')
  gameMode        String   @default("classic")
  // JSON: mode-specific configuration (rounds, timer, scoring weights, etc.)
  config          String   @default("{}")
  title           String
  description     String?
  status          String   @default("lobby") // 'lobby' | 'countdown' | 'in_progress' | 'paused' | 'finished' | 'cancelled'
  visibility      String   @default("private") // 'private' | 'classroom' | 'org' | 'public'
  maxPlayers      Int      @default(50)
  currentRound    Int      @default(0)
  totalRounds     Int      @default(10)
  // Live scoreboard snapshot (JSON: top-N players at the latest update)
  leaderboardSnapshot String @default("{}")
  startedAt       DateTime?
  finishedAt      DateTime?
  // Reconnect / host migration
  currentHostSocketId String?
  // Soft delete
  archivedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  players         LivePlayer[]
  rounds          LiveRound[]
  leaderboard     LiveLeaderboard[]
  rewards         GameReward[]
  replay          Replay?
  tournamentMatchesAsMatch1 TournamentMatch[] @relation("Match1Session")
  tournamentMatchesAsMatch2 TournamentMatch[] @relation("Match2Session")
  lobby           Lobby?

  @@index([hostId])
  @@index([orgId])
  @@index([classroomId])
  @@index([resourceId])
  @@index([assessmentId])
  @@index([gameMode])
  @@index([status])
  @@index([code])
}

// -----------------------------------------------------------------------------
// LivePlayer — a participant in a live session
// -----------------------------------------------------------------------------

model LivePlayer {
  id              String   @id @default(cuid())
  sessionId       String
  session         LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation("UserLivePlayers", fields: [userId], references: [id], onDelete: Cascade)
  // Player display name within the session (defaults to user.name)
  displayName     String
  // 'host' | 'co_host' | 'player' | 'spectator'
  role            String   @default("player")
  status          String   @default("active") // 'active' | 'eliminated' | 'disconnected' | 'left'
  // Game-mode-specific state (hearts, gold, empire power, etc.) as JSON
  state           String   @default("{}")
  // Live scoring aggregates
  score           Int      @default(0)
  accuracy        Float    @default(0)
  correctCount    Int      @default(0)
  wrongCount      Int      @default(0)
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  avgResponseMs   Int      @default(0)
  totalResponseMs Int      @default(0)
  answeredCount   Int      @default(0)
  // Final rank within the session (set when session finishes)
  finalRank       Int?
  // Reconnect
  socketId        String?
  lastSeenAt      DateTime @default(now())
  disconnectedAt  DateTime?
  joinedAt        DateTime @default(now())
  leftAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  answers         LiveAnswer[]
  rewards         GameReward[]

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@index([status])
  @@index([socketId])
}

// -----------------------------------------------------------------------------
// LiveRound — one question round within a session
// -----------------------------------------------------------------------------

model LiveRound {
  id              String   @id @default(cuid())
  sessionId       String
  session         LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roundNumber     Int
  questionId      String?
  question        BankQuestion? @relation("LiveRoundQuestion", fields: [questionId], references: [id], onDelete: SetNull)
  // Snapshot of the question payload at the time the round started — so the
  // replay is fully self-contained even if the question is later edited.
  questionSnapshot String? // JSON
  // Timing
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  questionDurationMs Int   @default(30000)
  answerLockAt    DateTime?
  revealAt        DateTime?
  // Per-round stats
  answerCount     Int      @default(0)
  correctCount    Int      @default(0)
  // Round-level leaderboard snapshot (JSON: array of {playerId, score, isCorrect, responseMs})
  resultsSnapshot String   @default("{}")
  status          String   @default("active") // 'active' | 'finished'

  answers         LiveAnswer[]

  @@unique([sessionId, roundNumber])
  @@index([sessionId])
  @@index([questionId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// LiveAnswer — a player's answer to a single round
// -----------------------------------------------------------------------------

model LiveAnswer {
  id              String   @id @default(cuid())
  roundId         String
  round           LiveRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  playerId        String
  player          LivePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  // JSON: the player's answer (varies by question type)
  answer          String?
  isCorrect       Boolean?
  // Time from round start to answer submission, in ms
  responseMs      Int      @default(0)
  // Base points + speed bonus + mode-specific adjustments
  pointsAwarded   Int      @default(0)
  // Mode-specific metadata (e.g. treasure: action='steal', target=playerId)
  metadata        String?
  submittedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([roundId, playerId])
  @@index([roundId])
  @@index([playerId])
  @@index([isCorrect])
}

// -----------------------------------------------------------------------------
// LiveLeaderboard — point-in-time snapshot for animations + replay
// -----------------------------------------------------------------------------

model LiveLeaderboard {
  id              String   @id @default(cuid())
  sessionId       String
  session         LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roundNumber     Int      @default(0) // 0 = pre-game; N = after round N
  // JSON array of { playerId, displayName, score, accuracy, responseMs, rank, streak, change }
  entries         String   @default("[]")
  generatedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([sessionId, roundNumber])
  @@index([generatedAt])
}

// -----------------------------------------------------------------------------
// Lobby — pre-game gathering place
// -----------------------------------------------------------------------------

model Lobby {
  id              String   @id @default(cuid())
  sessionId       String   @unique
  session         LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // 6-character human-friendly join code (e.g. "AB3KZ9")
  joinCode        String   @unique
  // Optional bcrypt-hashed password
  passwordHash    String?
  visibility      String   @default("private") // 'private' | 'classroom' | 'org' | 'public'
  maxPlayers      Int      @default(50)
  // JSON array of userIds in the waiting room (when host requires approval)
  waitingRoom     String   @default("[]")
  // JSON: lobby settings (game mode, rounds, timer, etc.)
  settings        String   @default("{}")
  // Host controls
  locked          Boolean  @default(false)
  countdownEndsAt DateTime?
  status          String   @default("open") // 'open' | 'countdown' | 'closed'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([joinCode])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Replay — full session history (event-sourced)
// -----------------------------------------------------------------------------

model Replay {
  id              String   @id @default(cuid())
  sessionId       String   @unique
  session         LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // JSON array of events in chronological order. Each event has:
  // { type, timestamp, payload, actorId }
  // Events include: round_started, answer_submitted, round_finished,
  // leaderboard_updated, player_eliminated, host_migrated, etc.
  events          String   @default("[]")
  // Final state snapshot — full leaderboard + per-player stats at session end
  finalSnapshot   String   @default("{}")
  durationMs      Int      @default(0)
  // Visibility: who can view this replay
  visibility      String   @default("session_participants") // 'session_participants' | 'classroom' | 'org' | 'public'
  // Analytics summary (JSON: per-question stats, drop-off, etc.)
  analyticsSummary String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([visibility])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Tournament — bracket system
// -----------------------------------------------------------------------------

model Tournament {
  id              String   @id @default(cuid())
  name            String
  description     String?
  hostId          String
  host            User     @relation("HostedTournaments", fields: [hostId], references: [id], onDelete: Cascade)
  orgId           String?
  org             Organization? @relation("OrgTournaments", fields: [orgId], references: [id], onDelete: Cascade)
  classroomId     String?
  gameMode        String   @default("classic")
  // JSON: bracket structure { rounds: [{ matches: [{ matchId, player1Id, player2Id, winnerId, sessionId }] }] }
  bracket         String   @default("{}")
  // 'single_elimination' | 'double_elimination' | 'round_robin'
  format          String   @default("single_elimination")
  // Number of players in the first round (must be a power of 2 for single elim)
  bracketSize     Int      @default(8)
  status          String   @default("draft") // 'draft' | 'registration' | 'in_progress' | 'finished' | 'cancelled'
  // JSON array of registered player userIds
  participants    String   @default("[]")
  championId      String?  // userId of the winner
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  matches         TournamentMatch[]

  @@index([hostId])
  @@index([orgId])
  @@index([classroomId])
  @@index([status])
}

model TournamentMatch {
  id              String   @id @default(cuid())
  tournamentId    String
  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  roundNumber     Int      // 1 = first round, 2 = quarterfinals, etc.
  matchNumber     Int      // match index within the round
  // The two players (userId); player2Id may be null for a bye
  player1Id       String
  player2Id       String?
  // The live session that decides this match
  session1Id      String?
  session1        LiveSession? @relation("Match1Session", fields: [session1Id], references: [id], onDelete: SetNull)
  session2Id      String?  // reserved for double-elimination loser-bracket matches
  session2        LiveSession? @relation("Match2Session", fields: [session2Id], references: [id], onDelete: SetNull)
  winnerId        String?
  score1          Int?
  score2          Int?
  status          String   @default("pending") // 'pending' | 'in_progress' | 'finished' | 'bye'
  scheduledAt     DateTime?
  finishedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tournamentId])
  @@index([roundNumber])
  @@index([status])
}

// -----------------------------------------------------------------------------
// GameReward — XP, coins, achievements, badges, season points
// -----------------------------------------------------------------------------

model GameReward {
  id              String   @id @default(cuid())
  sessionId       String?
  session         LiveSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  playerId        String?
  player          LivePlayer? @relation(fields: [playerId], references: [id], onDelete: SetNull)
  userId          String
  user            User     @relation("UserGameRewards", fields: [userId], references: [id], onDelete: Cascade)
  // 'xp' | 'coins' | 'achievement' | 'streak' | 'badge' | 'season_points' | 'title'
  rewardType      String
  // Numeric value for xp/coins/season_points; null for achievement/badge/title
  amount          Int?
  // Identifier for achievements/badges/titles (e.g. 'first_win', 'flawless_victory')
  code            String?
  // JSON metadata (e.g. { tier: 'gold', icon: '...' })
  metadata        String?
  reason          String?  // human-readable reason
  grantedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([sessionId])
  @@index([playerId])
  @@index([userId])
  @@index([rewardType])
  @@index([code])
}


// =============================================================================
// PHASE 4E.5 — MULTILINGUAL CONTENT ARCHITECTURE
// =============================================================================
//
// The translation layer pattern:
//
//   Entity (Resource, Quiz, Course, etc.)
//     ↓
//   Translation Layer (ResourceTranslation)
//     ↓
//   Language Variants (en, uz, ru, ...)
//
// One logical entity. Multiple localized variants.
// No duplication of IDs, ownership, or relationships.
//
// Translation statuses track the lifecycle:
//   draft → reviewing → approved → published → outdated
//                              ↘ missing
// =============================================================================

model ResourceTranslation {
  id              String   @id @default(cuid())
  resourceId      String
  resource        Resource @relation("ResourceTranslations", fields: [resourceId], references: [id], onDelete: Cascade)
  language        String   // ISO 639-1 (e.g. "en", "uz", "ru")
  // Localized content fields — override the parent resource's fields
  title           String
  description     String?
  content         String   @default("{}") // JSON-serialized localized content
  // Translation metadata
  translationStatus String @default("draft") // 'draft' | 'reviewing' | 'approved' | 'published' | 'outdated' | 'missing'
  translatedBy    String?  // userId of human translator (null = AI-generated)
  translationProvider String? // 'ai' | 'manual' | 'google' | 'deepl'
  translationVersion Int   @default(1)
  translatedAt    DateTime?
  isAutoGenerated Boolean  @default(false)
  // SEO
  slug            String?
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([resourceId, language])
  @@index([resourceId])
  @@index([language])
  @@index([translationStatus])
  @@index([slug])
}

model CategoryTranslation {
  id              String   @id @default(cuid())
  categoryId      String
  category        MpCategory @relation("CategoryTranslations", fields: [categoryId], references: [id], onDelete: Cascade)
  language        String   // ISO 639-1
  name            String
  description     String?
  slug            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([categoryId, language])
  @@index([categoryId])
  @@index([language])
  @@index([slug])
}

model SubscriptionPlanTranslation {
  id              String   @id @default(cuid())
  planId          String
  plan            SubscriptionPlan @relation("PlanTranslations", fields: [planId], references: [id], onDelete: Cascade)
  language        String   // ISO 639-1
  name            String
  description     String?
  features        String?  // JSON string — localized feature list
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([planId, language])
  @@index([planId])
  @@index([language])
}


// =============================================================================
// PHASE 4F.1 — UNIVERSAL SEARCH, KNOWLEDGE GRAPH & DISCOVERY ENGINE
// =============================================================================
//
// Models:
//   • KnowledgeGraphNode    — every searchable entity becomes a graph node
//   • KnowledgeGraphEdge    — typed relationships between nodes
//   • SearchIndexEntry      — unified search index across all modules
//   • Topic                 — hierarchical topic tree (first-class objects)
//   • TopicEdge             — parent/child/prerequisite relationships
//   • SearchAnalyticsEvent  — search tracking for analytics
//
// The discovery layer is additive — existing modules continue working
// unchanged while automatically participating in the new index.
// =============================================================================

model KnowledgeGraphNode {
  id            String   @id @default(cuid())
  entityType    String   // 'resource' | 'quiz' | 'question' | 'marketplace_listing' | 'classroom' | 'user' | 'organization' | 'topic' | 'course' | 'certificate' | 'ai_session'
  entityId      String   // the ID of the actual entity (Resource.id, etc.)
  title         String
  description   String?
  // Search payload — JSON with type-specific fields for indexing
  payload       String   @default("{}") // JSON: { subject, grade, difficulty, tags, language, ... }
  // Graph metadata
  popularity    Float    @default(0)   // 0-1, computed from views/favorites/purchases
  quality       Float    @default(0.5) // 0-1, computed from ratings/reviews
  // Locale
  language      String   @default("en")
  availableLanguages String @default("[]") // JSON array
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Edges (relationships)
  edgesFrom     KnowledgeGraphEdge[] @relation("EdgeFrom")
  edgesTo       KnowledgeGraphEdge[] @relation("EdgeTo")

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([entityType, entityId])
  @@index([title])
  @@index([language])
  @@index([popularity])
  @@index([quality])
}

model KnowledgeGraphEdge {
  id          String   @id @default(cuid())
  fromNodeId  String
  fromNode    KnowledgeGraphNode @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId    String
  toNode      KnowledgeGraphNode @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  // Relationship type
  edgeType    String   // 'RELATED' | 'PREREQUISITE' | 'NEXT' | 'DERIVED_FROM' | 'TRANSLATED_FROM' | 'USES' | 'BELONGS_TO' | 'CREATED_BY' | 'PART_OF' | 'SIMILAR' | 'REFERENCES' | 'DUPLICATE'
  // Edge weight (0-1, higher = stronger relationship)
  weight      Float    @default(0.5)
  metadata    String?  // JSON: additional edge-specific data
  createdAt   DateTime @default(now())

  @@unique([fromNodeId, toNodeId, edgeType])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([edgeType])
}

model SearchIndexEntry {
  id            String   @id @default(cuid())
  entityType    String   // 'resource' | 'quiz' | 'question' | 'marketplace_listing' | ...
  entityId      String
  title         String
  description   String?
  // Tokenized + normalized search text (lowercased, stemmed)
  searchText    String
  // Filters
  language      String   @default("en")
  subject       String?
  grade         String?
  difficulty    String?
  resourceType  String?
  tags          String   @default("[]") // JSON array
  // Ranking signals
  popularity    Float    @default(0)
  quality       Float    @default(0.5)
  freshness     Float    @default(1)   // 0-1, decays over time
  // Ownership
  ownerId       String?
  orgId         String?
  // Marketplace
  price         Float?
  isMarketplace Boolean  @default(false)
  isVerified    Boolean  @default(false)
  // AI
  isAiGenerated Boolean  @default(false)
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([entityType, entityId])
  @@index([language])
  @@index([subject])
  @@index([difficulty])
  @@index([resourceType])
  @@index([isMarketplace])
  @@index([popularity])
}

model Topic {
  id              String   @id @default(cuid())
  name            String
  description     String?
  parentId        String?  // parent topic (null = root)
  parent          Topic?   @relation("TopicChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children        Topic[]  @relation("TopicChildren")
  // Metadata
  difficulty      String   @default("medium") // 'easy' | 'medium' | 'hard'
  recommendedAge  String?  // e.g. "12-15"
  estimatedStudyTimeMin Int?
  // Locale
  language        String   @default("en")
  slug            String?
  // Graph
  aliases         String   @default("[]") // JSON array of alternative names
  keywords        String   @default("[]") // JSON array of SEO keywords
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Prerequisite edges
  prerequisites   TopicEdge[] @relation("TopicPrerequisiteFrom")
  requiredFor     TopicEdge[] @relation("TopicPrerequisiteTo")

  @@index([parentId])
  @@index([language])
  @@index([slug])
  @@index([difficulty])
}

model TopicEdge {
  id              String   @id @default(cuid())
  fromTopicId     String
  fromTopic       Topic    @relation("TopicPrerequisiteFrom", fields: [fromTopicId], references: [id], onDelete: Cascade)
  toTopicId       String
  toTopic         Topic    @relation("TopicPrerequisiteTo", fields: [toTopicId], references: [id], onDelete: Cascade)
  // Edge type: 'PREREQUISITE' | 'NEXT' | 'RELATED'
  edgeType        String   @default("PREREQUISITE")
  weight          Float    @default(0.5)
  createdAt       DateTime @default(now())

  @@unique([fromTopicId, toTopicId, edgeType])
  @@index([fromTopicId])
  @@index([toTopicId])
}

model SearchAnalyticsEvent {
  id            String   @id @default(cuid())
  userId        String?
  query         String
  locale        String   @default("en")
  resultCount   Int      @default(0)
  clickedEntityId String?
  clickedEntityType String?
  // Analytics
  crossLanguageMatch Boolean @default(false)
  responseTimeMs Int?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([query])
  @@index([locale])
  @@index([createdAt])
}


// =============================================================================
// PHASE 4F.2 — SEMANTIC SEARCH, PERSONALIZATION & AI RECOMMENDATIONS
// =============================================================================

model Embedding {
  id            String   @id @default(cuid())
  entityType    String   // 'resource' | 'quiz' | 'question' | 'topic' | ...
  entityId      String
  // Vector stored as JSON array of floats (384-dimensional for efficiency)
  vector        String   @default("[]")
  // Model used to generate the embedding
  model         String   @default("sentence-transformer")
  // Content hash for change detection
  contentHash   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([entityType, entityId])
}

model UserInterestProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  // JSON: { "mathematics": 0.8, "physics": 0.6, "programming": 0.3, ... }
  interests     String   @default("{}")
  // JSON: { "algebra": "mastered", "newton_laws": "learning", "fractions": "weak", ... }
  mastery       String   @default("{}")
  // JSON: { "algebra": 0.9, "geometry": 0.3, ... }
  topicAffinity String   @default("{}")
  // JSON: { "algebra": { "viewed": 5, "quiz_attempted": 2, "completed": 1 }, ... }
  // Phase 4F.2: raw behavioral signal counts per topic, used for explainability
  signals       String   @default("{}")
  // Last recomputation
  lastComputedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model RecommendationCache {
  id            String   @id @default(cuid())
  userId        String
  strategy      String   // 'for_you' | 'continue_learning' | 'weak_topics' | ...
  // JSON array of recommendation DTOs
  recommendations String @default("[]")
  locale        String   @default("en")
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@unique([userId, strategy, locale])
  @@index([userId])
  @@index([expiresAt])
}

model SearchSession {
  id            String   @id @default(cuid())
  userId        String?
  query         String
  locale        String   @default("en")
  intent        String?  // 'learn' | 'exam' | 'worksheet' | 'quiz' | 'lesson' | 'review' | 'homework' | 'research'
  intentConfidence Float?
  resultCount   Int      @default(0)
  clickedEntityId String?
  clickedEntityType String?
  refinementQuery String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([query])
  @@index([createdAt])
}

model LearningIntent {
  id            String   @id @default(cuid())
  userId        String?
  query         String
  intent        String   // 'learn_concept' | 'prepare_exam' | 'find_worksheet' | 'generate_quiz' | 'create_lesson' | 'review_mistakes' | 'homework_help' | 'research'
  confidence    Float    @default(0)
  // JSON: extracted entities, topics, difficulty from the query
  extractedEntities String @default("{}")
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([intent])
}

model SemanticCluster {
  id            String   @id @default(cuid())
  name          String
  description   String?
  // JSON array of { entityType, entityId, similarity }
  members       String   @default("[]")
  // Cluster centroid vector
  centroid      String   @default("[]")
  topicId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([topicId])
}


// =============================================================================
// PHASE 4F.3 — AI LEARNING ORCHESTRATOR, ADAPTIVE LEARNING PATHS & STUDY PLANNER
// =============================================================================
// All models are ADDITIVE — no existing schema changes.
// Stored JSON fields use stable shapes documented in
// src/features/learning-planner/types.ts.

// A user's high-level learning goal ("Finish SAT Math", "Become React Dev").
// One goal can have many plans.
model LearningGoal {
  id              String   @id @default(cuid())
  userId          String
  title           String
  description     String?
  // JSON: { targetDate, dailyMinutes, currentLevel, targetLevel, topics: string[] }
  constraints     String   @default("{}")
  completionPct   Float    @default(0)
  confidence      Float    @default(0.5)
  // Estimated finish date based on current velocity (recomputed periodically).
  estimatedFinish DateTime?
  // ISO date when the goal was achieved (or null while in progress).
  achievedAt      DateTime?
  status          String   @default("active") // 'active' | 'paused' | 'achieved' | 'archived'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plans           LearningPlan[]

  @@index([userId])
  @@index([status])
}

// A study plan generated by the AI Learning Orchestrator. Belongs to a goal.
// Contains an ordered list of LearningPlanItem nodes (lessons, quizzes,
// reviews, AI sessions, marketplace resources).
model LearningPlan {
  id              String   @id @default(cuid())
  userId          String
  goalId          String?
  goal            LearningGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  // JSON: { difficultyCurve, estimatedTotalMinutes, confidenceScore, generatorVersion }
  metadata        String   @default("{}")
  completionPct   Float    @default(0)
  masteryPct      Float    @default(0)
  status          String   @default("active") // 'draft' | 'active' | 'paused' | 'completed' | 'archived'
  startedAt       DateTime?
  completedAt     DateTime?
  pausedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           LearningPlanItem[]

  @@index([userId])
  @@index([goalId])
  @@index([status])
}

// One node in a LearningPlan. Each item maps to a discoverable entity
// (resource, quiz, AI session, marketplace listing, review).
model LearningPlanItem {
  id              String   @id @default(cuid())
  planId          String
  plan            LearningPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  // Ordering within the plan (1-indexed).
  sortOrder       Int      @default(0)
  itemType        String   // 'lesson' | 'quiz' | 'review' | 'ai_session' | 'marketplace' | 'practice' | 'mock_exam'
  entityType      String
  entityId        String
  title           String
  // Estimated minutes to complete this item.
  estimatedMinutes Int     @default(30)
  difficulty      String   @default("medium") // 'easy' | 'medium' | 'hard' | 'expert'
  // JSON: { reason, reasonKey, confidence, expectedImpactPct, actionItems: string[] }
  recommendation  String   @default("{}")
  status          String   @default("pending") // 'pending' | 'in_progress' | 'completed' | 'skipped'
  startedAt       DateTime?
  completedAt     DateTime?
  actualMinutes   Int      @default(0)
  // Per-item mastery score after completion (0-1).
  masteryScore    Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([planId])
  @@index([sortOrder])
  @@index([status])
}

// A single study session log. Reuses LearningSession for low-level tracking
// but adds planner-level metadata (planItemId, mood, energy, focus).
model StudySession {
  id              String   @id @default(cuid())
  userId          String
  planId          String?
  planItemId      String?
  // Links to LearningSession for low-level interaction tracking.
  learningSessionId String?
  // Free-form session type: 'study' | 'review' | 'quiz' | 'ai_tutor' | 'practice' | 'mock_exam'
  sessionType     String   @default("study")
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  durationMs      Int      @default(0)
  // Accuracy 0-1 for quiz/practice sessions; null otherwise.
  accuracy        Float?
  // Difficulty encountered during the session ('easy'|'medium'|'hard'|'expert').
  difficulty      String?
  // Subjective inputs from the learner.
  mood            Int?     // 1-5
  energy          Int?     // 1-5
  focus           Int?     // 1-5
  // JSON: { topicsCovered: string[], weakSignals: string[], strongSignals: string[] }
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([planId])
  @@index([startedAt])
}

// Spaced-repetition schedule for a (userId, entityType, entityId) triple.
// One row per fact/concept being tracked. Implements SM-2.
model ReviewSchedule {
  id              String   @id @default(cuid())
  userId          String
  entityType      String
  entityId        String
  // SM-2 ease factor (default 2.5, min 1.3).
  easeFactor      Float    @default(2.5)
  // Current interval in days.
  intervalDays    Int      @default(1)
  // Number of times reviewed.
  repetitions     Int      @default(0)
  // Next review due date.
  nextReviewAt    DateTime @default(now())
  lastReviewAt    DateTime?
  // Forgetting score 0-1 (higher = more likely forgotten). Updated on each review.
  forgettingScore Float    @default(0)
  // JSON: { lastQuality: 0-5, history: [{ date, quality, timeMs }] }
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, entityType, entityId])
  @@index([userId, nextReviewAt])
  @@index([nextReviewAt])
}

// Append-only history of every review event. One row per review.
model ReviewHistory {
  id              String   @id @default(cuid())
  userId          String
  reviewScheduleId String
  // Quality grade 0-5 (SM-2 convention).
  quality         Int
  // Response time in milliseconds.
  responseMs      Int?
  // Whether the review was correct (quality >= 3).
  correct         Boolean  @default(false)
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([reviewScheduleId])
  @@index([createdAt])
}

// Auto-generated milestones. One row per (userId, type, threshold).
model LearningMilestone {
  id              String   @id @default(cuid())
  userId          String
  // Stable type tag: 'topic_mastered' | 'questions_completed' | 'plan_finished' | 'streak_reached' | 'readiness_reached' | 'concept_learned'
  type            String
  title           String
  description     String?
  // JSON: { topic, value, threshold, goalId }
  metadata        String   @default("{}")
  achievedAt      DateTime @default(now())
  // Whether the user has been notified (avoids duplicate notifications).
  notifiedAt      DateTime?

  @@index([userId])
  @@index([type])
  @@index([achievedAt])
}

// Periodic snapshot of learning velocity. One row per (userId, weekStart).
model LearningVelocitySnapshot {
  id              String   @id @default(cuid())
  userId          String
  // ISO week-start date (Monday 00:00 UTC).
  weekStart       DateTime
  conceptsLearned Int      @default(0)
  minutesStudied  Int      @default(0)
  masteryGained   Float    @default(0)
  quizImprovement Float    @default(0)
  // 0-1 consistency score (days studied / 7).
  consistency     Float    @default(0)
  // 0-1 probability the learner will drop off in the next week.
  dropOffProbability Float @default(0)
  createdAt       DateTime @default(now())

  @@unique([userId, weekStart])
  @@index([userId])
  @@index([weekStart])
}

// Periodic snapshot of analytics for the dashboard. One row per (userId, day).
model LearningAnalyticsSnapshot {
  id              String   @id @default(cuid())
  userId          String
  // ISO day (00:00 UTC).
  day             DateTime
  studyTimeMs     Int      @default(0)
  reviewCount     Int      @default(0)
  reviewSuccessRate Float  @default(0)
  masteryAvg      Float    @default(0)
  difficultyAvg   Float    @default(0)
  // 0-1 — fraction of recommendations accepted by the user.
  recommendationAcceptance Float @default(0)
  aiUsageCount    Int      @default(0)
  goalCompletionPct Float  @default(0)
  velocityScore   Float    @default(0)
  createdAt       DateTime @default(now())

  @@unique([userId, day])
  @@index([userId])
  @@index([day])
}


// =============================================================================
// PHASE 4F.4 — COLLABORATIVE LEARNING, ORGANIZATIONS & LEARNING INTELLIGENCE NETWORK
// =============================================================================
// All models are ADDITIVE — no existing schema changes.

// ---------------------------------------------------------------------------
// Study Groups
// ---------------------------------------------------------------------------

model StudyGroup {
  id            String   @id @default(cuid())
  name          String
  description   String?
  // 'public' | 'private' | 'invite_only'
  visibility    String   @default("public")
  ownerId       String
  // Optional: link to a classroom, course, or topic
  classroomId   String?
  organizationId String?
  subject       String?
  // Group-level XP — sum of member XP earned within the group
  groupXp       Int      @default(0)
  // Maximum member count (0 = unlimited)
  maxMembers    Int      @default(50)
  status        String   @default("active") // 'active' | 'archived' | 'frozen'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       StudyGroupMember[]
  invitations   GroupInvitation[]

  @@index([ownerId])
  @@index([organizationId])
  @@index([subject])
  @@index([visibility, status])
}

model StudyGroupMember {
  id            String   @id @default(cuid())
  groupId       String
  group         StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId        String
  // 'member' | 'moderator' | 'admin'
  role          String   @default("member")
  joinedAt      DateTime @default(now())
  // XP earned by this user within this group
  groupXp       Int      @default(0)
  status        String   @default("active") // 'active' | 'banned' | 'left'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, role])
}

model GroupInvitation {
  id            String   @id @default(cuid())
  groupId       String
  group         StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedBy     String
  inviteeId     String?
  // For email-based invites when the user doesn't have an account yet
  inviteeEmail  String?
  // 'pending' | 'accepted' | 'declined' | 'expired' | 'revoked'
  status        String   @default("pending")
  // Single-use token for invite link
  token         String   @unique @default(cuid())
  message       String?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([groupId])
  @@index([inviteeId])
  @@index([token])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Discussions (resource-scoped + classroom-scoped + group-scoped)
// ---------------------------------------------------------------------------

model Discussion {
  id            String   @id @default(cuid())
  // What this discussion is attached to.
  entityType    String   // 'resource' | 'assignment' | 'classroom' | 'study_group' | 'topic' | 'note'
  entityId      String
  title         String
  // Optional — the user who started the thread
  authorId      String?
  // Open / closed / archived / locked
  status        String   @default("open")
  // Pinned to top of the list
  pinned        Boolean  @default(false)
  // AI-generated summary, refreshed on demand
  aiSummary     String?
  aiSummaryAt   DateTime?
  replyCount    Int      @default(0)
  viewCount     Int      @default(0)
  lastReplyAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  replies       DiscussionReply[]

  @@index([entityType, entityId])
  @@index([authorId])
  @@index([status, pinned])
}

model DiscussionReply {
  id            String   @id @default(cuid())
  discussionId  String
  discussion    Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  authorId      String
  // For nested replies: parent reply id (null = top-level)
  parentId      String?
  body          String
  // Markdown-rendered HTML cache (optional)
  bodyHtml      String?
  // 'visible' | 'hidden' | 'deleted'
  status        String   @default("visible")
  // If this is an answer to a Q&A discussion, mark it as accepted
  isAcceptedAnswer Boolean @default(false)
  acceptedBy    String?
  acceptedAt    DateTime?
  // AI toxicity score (0-1, higher = more toxic)
  toxicityScore Float?
  // AI duplicate-of reply id (if AI detected this duplicates another reply)
  duplicateOfId String?
  editCount     Int      @default(0)
  lastEditedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reactions     DiscussionReaction[]

  @@index([discussionId])
  @@index([authorId])
  @@index([parentId])
  @@index([status])
}

model DiscussionReaction {
  id            String   @id @default(cuid())
  replyId       String
  reply         DiscussionReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  userId        String
  // Emoji short code: 'thumbs_up', 'thumbs_down', 'heart', 'fire', 'check', etc.
  emoji         String
  createdAt     DateTime @default(now())

  @@unique([replyId, userId, emoji])
  @@index([replyId, emoji])
}

// ---------------------------------------------------------------------------
// Collaborative Notes
// ---------------------------------------------------------------------------

model CollaborativeNote {
  id            String   @id @default(cuid())
  title         String
  // Optional — what this note is attached to (resource, topic, classroom, study_group)
  entityType    String?
  entityId      String?
  // Current markdown content (latest version)
  content       String   @default("")
  contentHtml   String?
  // Owner / creator
  ownerId       String
  // 'private' | 'shared' | 'classroom' | 'group' | 'public'
  visibility    String   @default("private")
  // Optional classroom/group association
  classroomId   String?
  groupId       String?
  // Last edit metadata
  lastEditedBy  String?
  lastEditedAt  DateTime?
  // AI summary cache
  aiSummary     String?
  aiSummaryAt   DateTime?
  // Active editors (for real-time presence) — JSON array of user IDs
  activeEditors String   @default("[]")
  wordCount     Int      @default(0)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  versions      CollaborativeNoteVersion[]

  @@index([ownerId])
  @@index([classroomId])
  @@index([groupId])
  @@index([entityType, entityId])
}

model CollaborativeNoteVersion {
  id            String   @id @default(cuid())
  noteId        String
  note          CollaborativeNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  version       Int
  content       String
  // User who created this version
  editedBy      String
  // Edit summary (optional, like a git commit message)
  editSummary   String?
  // Char diff vs previous version (for compact history)
  diffSize      Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([noteId, version])
  @@index([noteId, version])
  @@index([editedBy])
}

// ---------------------------------------------------------------------------
// Teacher Recommendations + Interventions + Announcements
// ---------------------------------------------------------------------------

model TeacherRecommendation {
  id            String   @id @default(cuid())
  teacherId     String
  classroomId   String?
  // 'intervention' | 'enrichment' | 'remediation' | 'announcement' | 'assignment' | 'study_plan'
  type          String
  title         String
  description   String?
  // Target student IDs (empty = whole class)
  targetUserIds String   @default("[]") // JSON array
  // JSON: { resourceIds, quizIds, worksheetIds, ... }
  resources     String   @default("{}")
  // AI-generated rationale
  rationale     String?
  rationaleKey  String?
  confidence    Float    @default(0.5)
  // 'pending' | 'accepted' | 'dismissed' | 'applied'
  status        String   @default("pending")
  // When the teacher accepted and applied the recommendation
  appliedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([teacherId])
  @@index([classroomId])
  @@index([type, status])
}

model Intervention {
  id            String   @id @default(cuid())
  teacherId     String
  classroomId   String?
  // Single student or group
  studentIds    String   @default("[]") // JSON array
  // 'at_risk' | 'weak_topic' | 'low_engagement' | 'missed_assignments' | 'burnout' | 'enrichment'
  reason        String
  reasonKey     String?
  description   String
  // JSON: { resources: [], quizzes: [], worksheets: [], duration }
  actionPlan    String   @default("{}")
  // AI confidence 0-1
  confidence    Float    @default(0.5)
  status        String   @default("pending") // 'pending' | 'active' | 'resolved' | 'dismissed'
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([teacherId])
  @@index([classroomId])
  @@index([reason, status])
}

model Announcement {
  id            String   @id @default(cuid())
  authorId      String
  // Optional scope: classroom, study_group, organization
  classroomId   String?
  groupId       String?
  organizationId String?
  title         String
  body          String
  bodyHtml      String?
  // 'draft' | 'published' | 'archived'
  status        String   @default("draft")
  pinned        Boolean  @default(false)
  // AI-generated summary (for long announcements)
  aiSummary     String?
  // Scheduled publish time (null = immediate)
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([authorId])
  @@index([classroomId])
  @@index([groupId])
  @@index([organizationId])
  @@index([status, pinned])
}

// ---------------------------------------------------------------------------
// Challenges + Participation
// ---------------------------------------------------------------------------

model LearningChallenge {
  id            String   @id @default(cuid())
  title         String
  description   String?
  // 'weekly' | 'monthly' | 'tournament' | 'season' | 'department'
  type          String
  // 'xp' | 'questions_correct' | 'topics_mastered' | 'streak_days' | 'study_minutes'
  metric        String
  // Target value (e.g. 1000 XP, 50 questions, etc.)
  targetValue   Int
  // Optional scope: organization, classroom, group, department
  organizationId String?
  classroomId   String?
  groupId       String?
  department    String?
  // Reward configuration
  // 'xp' | 'badge' | 'certificate' | 'marketplace_reward' | 'org_points'
  rewardType    String   @default("xp")
  rewardValue   Int      @default(100)
  // 'xp' | 'badge' | 'certificate' | 'marketplace_reward' | 'org_points'
  secondRewardType String?
  secondRewardValue Int?
  startsAt      DateTime
  endsAt        DateTime
  status        String   @default("active") // 'active' | 'completed' | 'cancelled'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participations ChallengeParticipation[]

  @@index([organizationId])
  @@index([classroomId])
  @@index([groupId])
  @@index([type, status])
  @@index([startsAt, endsAt])
}

model ChallengeParticipation {
  id            String   @id @default(cuid())
  challengeId   String
  challenge     LearningChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId        String?
  groupId       String?
  // Running tally toward the target
  progress      Int      @default(0)
  completed     Boolean  @default(false)
  completedAt   DateTime?
  // Final rank within the challenge (1 = first place)
  rank          Int?
  // Reward granted
  rewardGranted Boolean  @default(false)
  rewardGrantedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([challengeId, userId])
  @@unique([challengeId, groupId])
  @@index([challengeId, completed])
  @@index([challengeId, rank])
}

// ---------------------------------------------------------------------------
// Peer Recommendations + Mentorship
// ---------------------------------------------------------------------------

model PeerRecommendation {
  id            String   @id @default(cuid())
  userId        String
  // Recommended peer
  peerId        String
  // 'study_partner' | 'mentor' | 'mentee' | 'helper' | 'discussion_participant' | 'project_teammate'
  type          String
  // 0-1 match score
  score         Float
  // JSON: { sharedInterests, masteryOverlap, languageMatch, timezoneMatch, subjectOverlap }
  signals       String   @default("{}")
  reason        String
  reasonKey     String?
  // 'pending' | 'accepted' | 'dismissed'
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, peerId, type])
  @@index([userId, type])
  @@index([userId, status])
}

model Mentorship {
  id            String   @id @default(cuid())
  mentorId      String
  menteeId      String
  // Optional: topic / subject focus
  subject       String?
  // 'pending' | 'active' | 'paused' | 'completed' | 'ended'
  status        String   @default("pending")
  // Mentor's stated goals (JSON array)
  goals         String   @default("[]")
  // Total sessions held
  sessionsCount Int      @default(0)
  lastSessionAt DateTime?
  // End date if completed/ended
  endedAt       DateTime?
  // Reason for ending (if ended)
  endReason     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([mentorId, menteeId, subject])
  @@index([mentorId])
  @@index([menteeId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Insights — precomputed snapshots for fast dashboard loading
// ---------------------------------------------------------------------------

model ClassInsight {
  id            String   @id @default(cuid())
  classroomId   String
  // ISO day (00:00 UTC)
  day           DateTime
  // Student count enrolled
  studentCount  Int      @default(0)
  // Avg mastery across students (0-1)
  avgMastery    Float    @default(0)
  // Top weak topics (JSON array of { topic, mastery })
  weakTopics    String   @default("[]")
  // Top strong topics (JSON array)
  strongTopics  String   @default("[]")
  // Avg learning velocity (concepts/day)
  avgVelocity   Float    @default(0)
  // Engagement rate (0-1) — fraction of students active in last 7 days
  engagementRate Float   @default(0)
  // Students predicted to be at risk (JSON array of { userId, riskScore, reason })
  atRiskStudents String  @default("[]")
  // Total classroom study time in ms for the day
  totalStudyTimeMs Int   @default(0)
  // Assignment completion rate (0-1)
  assignmentCompletionRate Float @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([classroomId, day])
  @@index([classroomId])
  @@index([day])
}

model OrganizationInsight {
  id            String   @id @default(cuid())
  organizationId String
  // ISO day (00:00 UTC)
  day           DateTime
  // Department-level analytics — JSON map of department → metrics
  departmentAnalytics String @default("{}")
  // Teacher analytics — JSON array of { teacherId, name, classrooms, avgMastery, students }
  teacherAnalytics String @default("[]")
  // Resource usage — JSON: { totalResources, topResources, aiGenerated, marketplacePurchased }
  resourceUsage String   @default("{}")
  // AI usage — JSON: { totalSessions, totalCreditsUsed, topModels }
  aiUsage       String   @default("{}")
  // Certification progress — JSON: { totalEnrolled, totalCompleted, avgScore }
  certificationProgress String @default("{}")
  // Cross-class comparison — JSON array of { classroomId, name, avgMastery, avgEngagement }
  classComparison String @default("[]")
  // Total members + active members
  totalMembers  Int      @default(0)
  activeMembers Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([organizationId, day])
  @@index([organizationId])
  @@index([day])
}


// =============================================================================
// PHASE 4F.5 — KNOWLEDGE INTELLIGENCE, CURRICULUM MAPPING & AUTONOMOUS AI EDUCATION ENGINE
// =============================================================================
// All models are ADDITIVE — no existing schema changes.

// ---------------------------------------------------------------------------
// Concepts — atomic educational concepts (e.g. "quadratic formula")
// ---------------------------------------------------------------------------

model Concept {
  id            String   @id @default(cuid())
  // Slugified canonical name, e.g. "quadratic-formula"
  slug          String   @unique
  // Human-readable name
  name          String
  description   String?
  // Subject: "mathematics" | "physics" | "chemistry" | ...
  subject       String?
  // Bloom taxonomy level: 'remember' | 'understand' | 'apply' | 'analyze' | 'evaluate' | 'create'
  bloomLevel    String?
  // Estimated difficulty 0-1 (AI-computed)
  difficulty    Float    @default(0.5)
  // Estimated learning time in minutes
  estimatedMinutes Int   @default(30)
  // JSON: { formulas: string[], definitions: string[], keywords: string[], skills: string[], examples: string[], vocabulary: string[], misconceptions: string[] }
  attributes    String   @default("{}")
  // Locale of the canonical concept (concepts can be translated)
  language      String   @default("en")
  // AI confidence in the extracted attributes (0-1)
  aiConfidence  Float    @default(0.5)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aliases       ConceptAlias[]
  resourceConcepts ResourceConcept[]
  conceptRelationshipsFrom ConceptRelationship[] @relation("ConceptRelationshipFrom")
  conceptRelationshipsTo   ConceptRelationship[] @relation("ConceptRelationshipTo")
  mastery       ConceptMastery[]

  @@index([subject])
  @@index([bloomLevel])
  @@index([language])
}

model ConceptAlias {
  id          String   @id @default(cuid())
  conceptId   String
  concept     Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  // The alias term (e.g. "quadratic eq" for "quadratic formula")
  alias       String
  // Language of this alias
  language    String   @default("en")
  // Source: 'manual' | 'ai_extracted' | 'curriculum_imported'
  source      String   @default("manual")
  createdAt   DateTime @default(now())

  @@unique([conceptId, alias, language])
  @@index([alias, language])
}

// ---------------------------------------------------------------------------
// Learning Objectives
// ---------------------------------------------------------------------------

model LearningObjective {
  id          String   @id @default(cuid())
  // Owning curriculum framework (optional — some objectives are organization-local)
  frameworkId String?
  framework   CurriculumFramework? @relation(fields: [frameworkId], references: [id], onDelete: SetNull)
  // Objective code, e.g. "8.A.1" for Grade 8 Algebra objective 1
  code        String
  title       String
  description String?
  // Subject area: "algebra" | "geometry" | "biology" | ...
  subject     String
  // Grade level: "K" | "1" | ... | "12" | "university"
  grade       String
  // Bloom level
  bloomLevel  String?
  // JSON array of concept IDs that satisfy this objective
  conceptIds  String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([frameworkId, code])
  @@index([frameworkId])
  @@index([subject, grade])
  @@index([code])
}

// ---------------------------------------------------------------------------
// Curriculum Frameworks + Standards
// ---------------------------------------------------------------------------

model CurriculumFramework {
  id          String   @id @default(cuid())
  // 'uzbekistan' | 'cambridge' | 'ib' | 'ap' | 'sat' | 'gcse' | 'custom'
  code        String   @unique
  name        String
  description String?
  // Country / region
  region      String?
  // Default language for this framework
  language    String   @default("en")
  // Owning organization (null = global framework)
  organizationId String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  standards   CurriculumStandard[]
  objectives  LearningObjective[]

  @@index([organizationId])
  @@index([status])
}

model CurriculumStandard {
  id            String   @id @default(cuid())
  frameworkId   String
  framework     CurriculumFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  // Standard code, e.g. "8.A.1.2" — Solve linear equations in one variable.
  code          String
  title         String
  description   String?
  subject       String
  grade         String
  // Strand / topic area within the framework
  strand        String?
  // JSON: expected outcomes (what the student should be able to do)
  outcomes      String   @default("[]")
  // Bloom level expected
  bloomLevel    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mappings      CurriculumMapping[]

  @@unique([frameworkId, code])
  @@index([frameworkId])
  @@index([subject, grade])
  @@index([strand])
}

// ---------------------------------------------------------------------------
// Curriculum Mapping (resource ↔ standard)
// ---------------------------------------------------------------------------

model CurriculumMapping {
  id            String   @id @default(cuid())
  standardId    String
  standard      CurriculumStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  // What entity maps to this standard
  entityType    String   // 'resource' | 'quiz' | 'assessment' | 'lesson'
  entityId      String
  // Alignment confidence 0-1 (how strongly the AI thinks this resource covers the standard)
  alignmentScore Float   @default(0.5)
  // Coverage level: 'partial' | 'full' | 'introduces' | 'reinforces' | 'assesses'
  coverageLevel String   @default("partial")
  // AI rationale
  rationale     String?
  // Source: 'ai' | 'manual' | 'imported'
  source        String   @default("ai")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([standardId, entityType, entityId])
  @@index([standardId])
  @@index([entityType, entityId])
  @@index([coverageLevel])
}

// ---------------------------------------------------------------------------
// Concept Relationships (a typed graph separate from KnowledgeGraphEdge)
// ---------------------------------------------------------------------------

model ConceptRelationship {
  id            String   @id @default(cuid())
  fromConceptId String
  fromConcept   Concept  @relation("ConceptRelationshipFrom", fields: [fromConceptId], references: [id], onDelete: Cascade)
  toConceptId   String
  toConcept     Concept  @relation("ConceptRelationshipTo", fields: [toConceptId], references: [id], onDelete: Cascade)
  // 'prerequisite' | 'next' | 'related' | 'part_of' | 'derived_from' | 'reinforces'
  type          String
  // AI confidence 0-1
  confidence    Float    @default(0.5)
  // Source: 'ai' | 'manual' | 'curriculum_imported'
  source        String   @default("ai")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([fromConceptId, toConceptId, type])
  @@index([fromConceptId])
  @@index([toConceptId])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Concept Mastery (per-user mastery of each concept)
// ---------------------------------------------------------------------------

model ConceptMastery {
  id            String   @id @default(cuid())
  userId        String
  conceptId     String
  concept       Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  // 0-1 mastery score
  mastery       Float    @default(0)
  // 'never' | 'learning' | 'weak' | 'mastered' | 'forgotten'
  level         String   @default("never")
  // Times practiced
  practiceCount Int      @default(0)
  // Last interaction timestamp
  lastPracticedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, conceptId])
  @@index([userId])
  @@index([conceptId])
  @@index([level])
}

// ---------------------------------------------------------------------------
// Resource ↔ Concept mapping
// ---------------------------------------------------------------------------

model ResourceConcept {
  id            String   @id @default(cuid())
  conceptId     String
  concept       Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  // What entity teaches/uses this concept
  entityType    String   // 'resource' | 'quiz' | 'assessment' | 'lesson'
  entityId      String
  // How the concept is used: 'teaches' | 'assesses' | 'references' | 'requires'
  relationship  String   @default("teaches")
  // AI confidence 0-1
  confidence    Float    @default(0.5)
  // Importance weight 0-1 (primary concept vs minor reference)
  weight        Float    @default(0.5)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([conceptId, entityType, entityId, relationship])
  @@index([conceptId])
  @@index([entityType, entityId])
  @@index([relationship])
}

// ---------------------------------------------------------------------------
// Knowledge Coverage + Gap Analysis
// ---------------------------------------------------------------------------

model KnowledgeCoverage {
  id            String   @id @default(cuid())
  // Scope: 'classroom' | 'organization' | 'framework'
  scopeType     String
  scopeId       String
  frameworkId   String
  // Total standards in framework
  totalStandards Int     @default(0)
  // Standards with at least one mapped resource
  coveredStandards Int   @default(0)
  // Standards with NO mapped resource
  uncoveredStandards Int @default(0)
  // Coverage percentage 0-100
  coveragePct   Float    @default(0)
  // JSON: { uncoveredStandardIds: string[], weakAreas: [{ strand, pct }], duplicateResources: [{ id, count }] }
  details       String   @default("{}")
  computedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([scopeType, scopeId, frameworkId])
  @@index([scopeType, scopeId])
}

model KnowledgeGap {
  id            String   @id @default(cuid())
  // Scope: 'classroom' | 'organization' | 'student' | 'framework'
  scopeType     String
  scopeId       String
  // Standard or concept that is missing
  standardId    String?
  conceptId     String?
  // Gap type: 'uncovered_standard' | 'missing_prerequisite' | 'weak_concept_coverage' | 'no_assessment' | 'duplicate_lesson'
  type          String
  description   String
  // Suggested action (AI-generated)
  suggestedAction String?
  // JSON: { affectedResources: string[], suggestedResources: string[] }
  metadata      String   @default("{}")
  // 'open' | 'resolved' | 'ignored'
  status        String   @default("open")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([scopeType, scopeId])
  @@index([type, status])
  @@index([standardId])
  @@index([conceptId])
}

// ---------------------------------------------------------------------------
// Resource Quality Analysis
// ---------------------------------------------------------------------------

model ResourceQuality {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  // Overall quality score 0-1
  overall       Float    @default(0.5)
  // Sub-scores 0-1
  clarity       Float    @default(0.5)
  depth         Float    @default(0.5)
  accuracy      Float    @default(0.5)
  difficulty    Float    @default(0.5)
  engagement    Float    @default(0.5)
  curriculumAlignment Float @default(0.5)
  assessmentQuality Float @default(0.5)
  accessibility Float    @default(0.5)
  // AI confidence in the analysis (0-1)
  aiConfidence  Float    @default(0.5)
  // JSON: { strengths: string[], weaknesses: string[], suggestions: string[] }
  analysis      String   @default("{}")
  // AI model used
  model         String   @default("edubek-quality-v1")
  analyzedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([overall])
}

// ---------------------------------------------------------------------------
// Similarity / Duplicate Detection
// ---------------------------------------------------------------------------

model SimilarityCluster {
  id            String   @id @default(cuid())
  // Cluster name (auto-generated from centroid title)
  name          String
  // Entity type the cluster covers
  entityType    String
  // JSON: [{ entityType, entityId, similarity: 0-1 }]
  members       String   @default("[]")
  // Centroid content hash for incremental updates
  centroidHash  String?
  // Threshold used to form this cluster (0-1)
  threshold     Float    @default(0.8)
  // 'duplicate' | 'similar' | 'translated_copy' | 'ai_variant'
  clusterType   String   @default("similar")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([entityType])
  @@index([clusterType])
}

// ---------------------------------------------------------------------------
// Learning Outcome Prediction
// ---------------------------------------------------------------------------

model LearningPrediction {
  id            String   @id @default(cuid())
  userId        String
  // What we're predicting for
  entityType    String   // 'quiz' | 'assessment' | 'resource' | 'plan'
  entityId      String
  // Predicted quiz score 0-1 (null if not applicable)
  predictedScore Float?
  // Predicted completion probability 0-1
  predictedCompletion Float?
  // Predicted dropout probability 0-1
  predictedDropout Float?
  // Predicted mastery probability 0-1
  predictedMastery Float?
  // Predicted study time in minutes
  predictedStudyMinutes Int?
  // Whether intervention is needed
  interventionNeeded Boolean @default(false)
  // Intervention reason (if needed)
  interventionReason String?
  // JSON: { signals: { accuracy, streak, mastery, velocity, engagement }, modelVersion }
  metadata      String   @default("{}")
  // AI confidence 0-1
  confidence    Float    @default(0.5)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([interventionNeeded])
}

// ---------------------------------------------------------------------------
// Knowledge Health Snapshot (org-level)
// ---------------------------------------------------------------------------

model KnowledgeHealthSnapshot {
  id            String   @id @default(cuid())
  organizationId String
  // ISO day (00:00 UTC)
  day           DateTime
  // Coverage score 0-1
  coverageScore Float    @default(0)
  // Quality score 0-1
  qualityScore  Float    @default(0)
  // Curriculum completeness 0-1
  curriculumCompleteness Float @default(0)
  // Knowledge graph density 0-1 (edges / max possible edges)
  graphDensity  Float    @default(0)
  // Resource freshness 0-1 (fraction of resources updated in last 90 days)
  resourceFreshness Float @default(0)
  // AI readiness 0-1 (fraction of resources with AI-extracted concepts)
  aiReadiness   Float    @default(0)
  // Student mastery distribution — JSON: { mastered: N, learning: N, weak: N, never: N }
  masteryDistribution String @default("{}")
  // Teacher contribution analytics — JSON: [{ teacherId, resourceCount, avgQuality }]
  teacherContributions String @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([organizationId, day])
  @@index([organizationId])
  @@index([day])
}


// =============================================================================
// PHASE 4F.6 — AUTONOMOUS EDUCATION OS, MULTI-AGENT AI & INSTITUTIONAL INTELLIGENCE
// =============================================================================
// All models are ADDITIVE — no existing schema changes.

// ---------------------------------------------------------------------------
// Agent Memory — shared conversational + contextual memory for all agents
// ---------------------------------------------------------------------------

model AgentMemory {
  id            String   @id @default(cuid())
  // Who the memory belongs to (user, classroom, organization, or 'system')
  scopeType    String   // 'user' | 'classroom' | 'organization' | 'system'
  scopeId      String
  // Memory type
  type         String   // 'conversation' | 'goal' | 'action' | 'context' | 'workflow'
  // Natural-language summary of the memory
  summary      String
  // Structured payload (JSON)
  payload      String   @default("{}")
  // Importance 0-1 (higher = retained longer)
  importance   Float    @default(0.5)
  // Optional: linked agent that produced this memory
  agentType    String?
  // Optional: linked workflow execution
  workflowId   String?
  // TTL in days (null = no expiry)
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([scopeType, scopeId])
  @@index([type])
  @@index([agentType])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Agent Workflow — multi-step orchestrated agent executions
// ---------------------------------------------------------------------------

model AgentWorkflow {
  id            String   @id @default(cuid())
  // Workflow type — see WorkflowType union in types.ts
  type         String
  // User/org that initiated the workflow
  initiatedBy  String
  scopeType    String   // 'user' | 'classroom' | 'organization'
  scopeId      String
  // Workflow status
  status       String   @default("pending") // 'pending' | 'running' | 'completed' | 'failed' | 'cancelled'
  // JSON: ordered list of steps [{ id, agent, action, status, startedAt, completedAt, result }]
  steps        String   @default("[]")
  // Final merged result (JSON)
  result       String?
  // Participating agents
  participatingAgents String @default("[]")
  // Execution time in ms
  executionMs  Int      @default(0)
  // Error message if failed
  error        String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([initiatedBy])
  @@index([scopeType, scopeId])
  @@index([type, status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Automation Rule — trigger-based automations
// ---------------------------------------------------------------------------

model AutomationRule {
  id            String   @id @default(cuid())
  name          String
  description   String?
  // Who owns this automation
  ownerId       String
  scopeType     String   // 'user' | 'classroom' | 'organization' | 'system'
  scopeId       String
  // Trigger: { event: 'ResourceCreated', conditions: { ... } }
  trigger       String   @default("{}")
  // Actions: [{ type: 'assign_review', params: { ... } }, ...]
  actions       String   @default("[]")
  // Whether the automation is enabled
  enabled       Boolean  @default(true)
  // Max executions per hour (rate limiting)
  maxPerHour    Int      @default(10)
  // Last fired at (for rate limiting)
  lastFiredAt   DateTime?
  // Execution count
  executionCount Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerId])
  @@index([scopeType, scopeId])
  @@index([enabled])
}

// ---------------------------------------------------------------------------
// Agent Execution Log — append-only audit trail of every agent execution
// ---------------------------------------------------------------------------

model AgentExecutionLog {
  id            String   @id @default(cuid())
  agentType     String
  // The task that was requested
  task          String
  // Input parameters (JSON)
  input         String   @default("{}")
  // Output / response (JSON)
  output        String?
  // AI reasoning metadata
  confidence    Float?
  reasoning     String?
  sources       String?  // JSON array of evidence references
  affectedModules String @default("[]") // JSON array of module names
  // Execution status
  status        String   @default("running") // 'running' | 'completed' | 'failed'
  executionMs   Int      @default(0)
  error         String?
  // Scope (who requested this execution)
  scopeType     String?
  scopeId       String?
  // Optional: linked workflow
  workflowId    String?
  createdAt     DateTime @default(now())

  @@index([agentType])
  @@index([status])
  @@index([scopeType, scopeId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Simulation Result — dry-run results from the Simulation Engine
// ---------------------------------------------------------------------------

model SimulationResult {
  id            String   @id @default(cuid())
  // The scenario being simulated
  scenario      String
  // Input parameters (JSON)
  input         String   @default("{}")
  // Predicted impact (JSON)
  predictions   String   @default("{}")
  // Affected entities (JSON: { teachers: [], students: [], resources: [], ... })
  affected      String   @default("{}")
  // Estimated costs (JSON: { aiCredits, workload, time })
  estimatedCosts String  @default("{}")
  // AI-generated summary
  summary       String?
  confidence    Float    @default(0.5)
  createdAt     DateTime @default(now())

  @@index([scenario])
  @@index([createdAt])
}


// =============================================================================
// PHASE 4F.7 — SELF-IMPROVING AI, CONTINUOUS LEARNING & PLATFORM INTELLIGENCE
// =============================================================================
// All models are ADDITIVE — no existing schema changes.

// ---------------------------------------------------------------------------
// Feedback Event — every important platform event becomes feedback
// ---------------------------------------------------------------------------

model FeedbackEvent {
  id            String   @id @default(cuid())
  // The event type: 'quiz_completed' | 'lesson_opened' | 'resource_abandoned' |
  // 'recommendation_clicked' | 'recommendation_ignored' | 'search_success' |
  // 'search_failure' | 'ai_generation_accepted' | 'ai_generation_regenerated' |
  // 'marketplace_purchase' | 'marketplace_refund' | 'course_completed' |
  // 'certificate_earned' | 'discussion_solved' | 'teacher_edited_ai_output' |
  // 'student_corrected_answer' | ...
  type          String
  // Optional user / scope
  userId        String?
  scopeType     String?  // 'user' | 'classroom' | 'organization' | 'platform'
  scopeId       String?
  // Optional target entity
  entityType    String?
  entityId      String?
  // JSON: { query, position, sessionId, ... } — type-specific payload
  payload       String   @default("{}")
  // The outcome: 'positive' | 'negative' | 'neutral'
  outcome       String   @default("neutral")
  // Quantitative signal value (0-1) — higher = more positive
  value         Float    @default(0.5)
  // Optional: linked experiment + variant (for A/B testing)
  experimentId  String?
  variant       String?
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([type, occurredAt])
  @@index([userId, occurredAt])
  @@index([scopeType, scopeId, occurredAt])
  @@index([entityType, entityId])
  @@index([experimentId, variant])
}

// ---------------------------------------------------------------------------
// Learning Signal — aggregated learning signals per entity
// ---------------------------------------------------------------------------

model LearningSignal {
  id            String   @id @default(cuid())
  // What we're tracking: 'recommendation' | 'search_result' | 'prompt' | 'resource' | ...
  signalType    String
  // The entity being tracked
  entityType    String
  entityId      String
  // Optional: secondary entity (e.g. for recommendations, the user)
  secondaryEntityType String?
  secondaryEntityId   String?
  // Aggregate metrics
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  completions   Int      @default(0)
  dismissals    Int      @default(0)
  ignores       Int      @default(0)
  // Computed success rate (clicks / impressions)
  ctr           Float    @default(0)
  // Computed satisfaction (completions / clicks)
  satisfaction  Float    @default(0)
  // Last N outcomes as a rolling window (JSON array of 'positive' | 'negative' | 'neutral')
  recentOutcomes String  @default("[]")
  // When the signal was last recomputed
  lastComputedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([signalType, entityType, entityId, secondaryEntityType, secondaryEntityId])
  @@index([signalType, entityType])
  @@index([signalType, ctr])
  @@index([signalType, satisfaction])
}

// ---------------------------------------------------------------------------
// Recommendation Outcome — track what happened after a recommendation was shown
// ---------------------------------------------------------------------------

model RecommendationOutcome {
  id            String   @id @default(cuid())
  userId        String
  // What was recommended
  entityType    String
  entityId      String
  // The strategy that produced this recommendation
  strategy      String
  // The position in the recommendation list (1-indexed)
  position      Int
  // Outcome: 'impression' | 'click' | 'open' | 'complete' | 'ignore' | 'dismiss' | 'helpful' | 'not_helpful'
  outcome       String
  // Time spent on the recommended entity (ms) — if applicable
  timeSpentMs   Int?
  // The recommendation's confidence at impression time
  confidence    Float?
  // Optional: linked experiment + variant
  experimentId  String?
  variant       String?
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([entityType, entityId])
  @@index([strategy, outcome])
  @@index([experimentId, variant])
}

// ---------------------------------------------------------------------------
// Search Outcome — track what happened after a search
// ---------------------------------------------------------------------------

model SearchOutcome {
  id            String   @id @default(cuid())
  userId        String?
  query         String
  // Number of results returned
  resultCount   Int
  // Position of the clicked result (null if no click)
  clickedPosition Int?
  clickedEntityId String?
  clickedEntityType String?
  // Whether the user reformulated the query (suggesting the first search failed)
  reformulated  Boolean  @default(false)
  // Whether the user abandoned the search (no click + no reformulation)
  abandoned     Boolean  @default(false)
  // Time spent on the clicked result (ms) — long-click vs short-click
  timeSpentMs   Int?
  // 'success' | 'failure' | 'partial'
  outcome       String   @default("neutral")
  // Optional: linked experiment + variant
  experimentId  String?
  variant       String?
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([query])
  @@index([outcome])
  @@index([experimentId, variant])
}

// ---------------------------------------------------------------------------
// Prompt Evaluation — track AI prompt performance
// ---------------------------------------------------------------------------

model PromptEvaluation {
  id            String   @id @default(cuid())
  // The prompt template version
  promptTemplateId String?
  promptVersion String?
  // The AI provider + model
  provider      String
  model         String
  // Generation metadata
  generationId  String?
  // Quality metrics (0-1)
  acceptanceScore Float  @default(0.5)  // did the user accept the output?
  regenerationRate Float @default(0)    // how often was it regenerated?
  editRate      Float    @default(0)    // how often was it edited?
  userRating    Float?                  // explicit user rating (0-1)
  // Cost + latency
  costCredits   Int      @default(0)
  latencyMs     Int      @default(0)
  // Locale
  locale        String   @default("en")
  // Computed overall quality (weighted blend)
  overallQuality Float   @default(0.5)
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([promptTemplateId, promptVersion])
  @@index([provider, model])
  @@index([overallQuality])
  @@index([occurredAt])
}

// ---------------------------------------------------------------------------
// Platform Experiment — A/B testing + feature flags
// ---------------------------------------------------------------------------

model PlatformExperiment {
  id            String   @id @default(cuid())
  name          String
  description   String?
  // 'ab_test' | 'ranking' | 'prompt' | 'recommendation' | 'search' | 'marketplace' | 'planner' | 'feature_flag'
  type          String
  // JSON: [{ name: 'control', weight: 50 }, { name: 'variant_a', weight: 50 }]
  variants      String   @default("[]")
  // Rollout percentage (0-100) — what % of users are in the experiment
  rolloutPct    Int      @default(100)
  // Success metric: 'ctr' | 'completion' | 'satisfaction' | 'revenue' | 'retention'
  successMetric String   @default("ctr")
  // Status: 'draft' | 'running' | 'paused' | 'completed' | 'cancelled'
  status        String   @default("draft")
  // The winning variant (set when the experiment completes)
  winnerVariant String?
  // Confidence in the winner (0-1)
  winnerConfidence Float?
  // Start + end dates
  startsAt      DateTime?
  endsAt        DateTime?
  // Owner
  ownerId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignments  ExperimentAssignment[]

  @@index([type, status])
  @@index([ownerId])
  @@index([status, startsAt, endsAt])
}

model ExperimentAssignment {
  id            String   @id @default(cuid())
  experimentId  String
  experiment    PlatformExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  userId        String
  variant       String
  // When the user was assigned
  assignedAt    DateTime @default(now())
  // Optional: the first outcome observed
  firstOutcome  String?
  firstOutcomeAt DateTime?

  @@unique([experimentId, userId])
  @@index([experimentId, variant])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Optimization Snapshot — auto-tuned parameters from observed behavior
// ---------------------------------------------------------------------------

model OptimizationSnapshot {
  id            String   @id @default(cuid())
  // What was optimized: 'cache_ttl' | 'ranking_weights' | 'recommendation_weights' |
  // 'embedding_freshness' | 'graph_density' | 'search_aliases' |
  // 'curriculum_mappings' | 'automation_thresholds' | 'planner_intervals' |
  // 'notification_timing'
  parameter     String
  // The previous value (JSON)
  previousValue String?
  // The new value (JSON)
  newValue      String
  // The observed metric that triggered the optimization
  metric        String
  // The improvement observed (delta, %)
  improvementPct Float?
  // AI confidence in the optimization
  confidence    Float    @default(0.5)
  // Whether the optimization was auto-applied or requires manual approval
  autoApplied   Boolean  @default(false)
  appliedAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([parameter])
  @@index([createdAt])
  @@index([autoApplied])
}

// ---------------------------------------------------------------------------
// Forecast Snapshot — predictive intelligence
// ---------------------------------------------------------------------------

model ForecastSnapshot {
  id            String   @id @default(cuid())
  // What's being forecast: 'dropout' | 'exam_success' | 'resource_popularity' |
  // 'marketplace_demand' | 'teacher_workload' | 'ai_credit_usage' |
  // 'resource_decay' | 'curriculum_gaps' | 'search_trends' | 'topic_popularity'
  forecastType  String
  // Optional scope
  scopeType     String?
  scopeId       String?
  // The forecasted value
  predictedValue Float?
  // The forecasted date / time horizon
  horizon       String?  // '7d' | '30d' | '90d' | '1y'
  // Confidence (0-1)
  confidence    Float    @default(0.5)
  // JSON: { historicalData, model, assumptions }
  metadata      String   @default("{}")
  // AI-generated natural-language explanation
  explanation   String?
  createdAt     DateTime @default(now())

  @@index([forecastType, scopeType, scopeId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Health Snapshot — per-subsystem health monitoring
// ---------------------------------------------------------------------------

model HealthSnapshot {
  id            String   @id @default(cuid())
  // Subsystem: 'discovery' | 'search' | 'recommendations' | 'ai' | 'marketplace' |
  // 'knowledge_graph' | 'education_os' | 'learning_planner' | 'localization' |
  // 'automation' | 'knowledge_intelligence' | 'collaboration'
  subsystem     String
  // Health status: 'healthy' | 'degraded' | 'down' | 'unknown'
  status        String   @default("unknown")
  // 0-1 health score
  score         Float    @default(0.5)
  // JSON: { metrics: {}, checks: [], alerts: [] }
  details       String   @default("{}")
  // Response time in ms (for the last health check)
  responseMs    Int?
  checkedAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([subsystem, checkedAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Audit Event — every autonomous action becomes auditable
// ---------------------------------------------------------------------------

model AuditEvent {
  id            String   @id @default(cuid())
  // What kind of autonomous action: 'recommendation' | 'ai_generation' |
  // 'workflow_execution' | 'automation_trigger' | 'student_flagged' |
  // 'teacher_notified' | 'optimization_applied' | 'experiment_assignment'
  actionType    String
  // The actor (agent / system / user) that performed the action
  actorType     String   @default("system")  // 'agent' | 'system' | 'user' | 'automation'
  actorId       String?
  // The affected entity
  entityType    String?
  entityId      String?
  // Optional: affected user
  affectedUserId String?
  // Optional: scope
  scopeType     String?
  scopeId       String?
  // JSON: { inputs, reasoning, confidence, affectedModules }
  reasoning     String   @default("{}")
  // The confidence in the action (0-1)
  confidence    Float?
  // The outcome: 'success' | 'failure' | 'pending'
  outcome       String   @default("success")
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([actionType, occurredAt])
  @@index([actorType, actorId])
  @@index([entityType, entityId])
  @@index([affectedUserId])
  @@index([scopeType, scopeId])
}

// ---------------------------------------------------------------------------
// Platform Insight — cross-cutting insights generated from all signals
// ---------------------------------------------------------------------------

model PlatformInsight {
  id            String   @id @default(cuid())
  // Insight category: 'curriculum' | 'marketplace' | 'organization' |
  // 'recommendation' | 'search' | 'ai' | 'learning' | 'forecast' | 'optimization'
  category      String
  // Insight type (within the category)
  type          String
  // Human-readable title
  title         String
  // Detailed description
  description   String
  // i18n key for the title
  titleKey      String?
  // i18n key for the description
  descriptionKey String?
  // JSON: { evidence: [], metrics: {}, recommendations: [] }
  evidence      String   @default("{}")
  // Confidence (0-1)
  confidence    Float    @default(0.5)
  // Severity: 'info' | 'warning' | 'critical' | 'success'
  severity      String   @default("info")
  // Optional: linked scope
  scopeType     String?
  scopeId       String?
  // Whether the insight has been acknowledged / dismissed
  acknowledgedAt DateTime?
  createdAt     DateTime @default(now())

  @@index([category, type])
  @@index([severity])
  @@index([scopeType, scopeId])
  @@index([createdAt])
}


// =============================================================================
// PHASE 5A.1 — AUTONOMOUS CLASSROOM OPERATIONS & DIGITAL TWIN PLATFORM
// =============================================================================
// All models are ADDITIVE — no existing schema changes.

// ---------------------------------------------------------------------------
// Digital Twin — base table for all twin types (classroom, student, teacher, institution)
// ---------------------------------------------------------------------------

model DigitalTwin {
  id            String   @id @default(cuid())
  // 'classroom' | 'student' | 'teacher' | 'institution'
  twinType      String
  // The entity this twin represents (classroomId, userId, organizationId)
  entityId      String
  // Current twin state (JSON — type-specific)
  state         String   @default("{}")
  // Twin version — incremented on each update
  version       Int      @default(1)
  // When the twin was last synced from source systems
  lastSyncedAt  DateTime?
  // Whether the twin is actively maintained
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([twinType, entityId])
  @@index([twinType])
  @@index([twinType, active])
  @@index([lastSyncedAt])
}

// ---------------------------------------------------------------------------
// Twin Snapshots — append-only historical snapshots for longitudinal analysis
// ---------------------------------------------------------------------------

model TwinSnapshot {
  id            String   @id @default(cuid())
  twinType      String
  entityId      String
  // ISO day — one snapshot per day per twin
  day           DateTime
  // Full twin state at this point in time (JSON)
  state         String   @default("{}")
  // What triggered this snapshot: 'scheduled' | 'event' | 'manual'
  trigger       String   @default("scheduled")
  createdAt     DateTime @default(now())

  @@unique([twinType, entityId, day])
  @@index([twinType, entityId, day])
}

// ---------------------------------------------------------------------------
// Academic Calendar
// ---------------------------------------------------------------------------

model AcademicCalendar {
  id            String   @id @default(cuid())
  organizationId String?
  // Academic year label, e.g. "2025-2026"
  year          String
  // Term / semester label, e.g. "Fall 2025"
  term          String?
  // ISO date range
  startDate     DateTime
  endDate       DateTime
  // JSON: { holidays: [{ date, name }], gradingPeriods: [{ start, end, name }], examPeriods: [{ start, end, name }] }
  schedule      String   @default("{}")
  // Status: 'planned' | 'active' | 'completed' | 'archived'
  status        String   @default("planned")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  events        CalendarEvent[]

  @@index([organizationId, year])
  @@index([status])
  @@index([startDate, endDate])
}

model CalendarEvent {
  id            String   @id @default(cuid())
  calendarId    String
  calendar      AcademicCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  // 'holiday' | 'exam' | 'grading_period' | 'curriculum_deadline' | 'school_event' | 'teacher_event'
  type          String
  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime?
  // Optional: affected entity (classroomId, subject, etc.)
  scopeType     String?
  scopeId       String?
  // JSON: { affectsAll, subjects, grades, ... }
  metadata      String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([calendarId, startDate])
  @@index([type, startDate])
  @@index([scopeType, scopeId])
}

// ---------------------------------------------------------------------------
// Autonomous Academic Workflows — event-triggered multi-step automations
// ---------------------------------------------------------------------------

model AcademicWorkflow {
  id            String   @id @default(cuid())
  // Triggering event type: 'quiz_finished' | 'lesson_completed' | 'assignment_submitted' | 'student_at_risk' | 'curriculum_gap' | 'semester_start' | 'exam_period_start'
  trigger       String
  // The workflow name: 'post_quiz_cascade' | 'at_risk_intervention' | 'semester_prep' | etc.
  name          String
  // Optional: scope
  scopeType     String?  // 'classroom' | 'student' | 'organization'
  scopeId       String?
  // JSON: [{ step, agent, task, status, startedAt, completedAt, result }]
  steps         String   @default("[]")
  // Status: 'pending' | 'running' | 'completed' | 'failed' | 'cancelled'
  status        String   @default("pending")
  // JSON: unified result
  result        String?
  // Execution time in ms
  executionMs   Int      @default(0)
  // Linked triggering entity (quizId, studentId, etc.)
  triggerEntityId String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([trigger, status])
  @@index([scopeType, scopeId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Academic Memory — longitudinal multi-year memory
// ---------------------------------------------------------------------------

model AcademicMemory {
  id            String   @id @default(cuid())
  // Memory scope: 'student' | 'teacher' | 'classroom' | 'organization'
  scopeType     String
  scopeId       String
  // Academic year this memory belongs to
  academicYear  String
  // Memory type: 'enrollment' | 'curriculum_history' | 'intervention' | 'achievement' | 'trajectory' | 'teacher_assignment' | 'class_composition'
  type          String
  // Human-readable summary
  summary       String
  // JSON payload — type-specific
  payload       String   @default("{}")
  // Importance 0-1
  importance    Float    @default(0.5)
  createdAt     DateTime @default(now())

  @@index([scopeType, scopeId, academicYear])
  @@index([type, academicYear])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Scenario Plans — what-if simulations
// ---------------------------------------------------------------------------

model ScenarioPlan {
  id            String   @id @default(cuid())
  // Scenario type: 'make_subject_mandatory' | 'change_class_size' | 'remove_quizzes' | 'ai_credit_forecast' | 'curriculum_change' | 'schedule_change'
  type          String
  title         String
  description   String?
  // JSON: scenario parameters
  parameters    String   @default("{}")
  // JSON: predicted outcomes
  predictions   String   @default("{}")
  // JSON: affected entities
  affected      String   @default("{}")
  // JSON: estimated costs
  estimatedCosts String  @default("{}")
  // AI-generated summary
  summary       String?
  // Confidence 0-1
  confidence    Float    @default(0.5)
  // Who created the scenario
  createdBy     String?
  // Status: 'draft' | 'completed' | 'archived'
  status        String   @default("draft")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type, status])
  @@index([createdBy])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Academic Operations Center — daily priority dashboard entries
// ---------------------------------------------------------------------------

model AcademicOperation {
  id            String   @id @default(cuid())
  organizationId String?
  // ISO day this operation belongs to
  day           DateTime
  // Priority: 1 (highest) to 5 (lowest)
  priority      Int      @default(3)
  // Operation type: 'classroom_needs_attention' | 'student_at_risk' | 'curriculum_delay' | 'missing_assessment' | 'overloaded_teacher' | 'optimization_opportunity' | 'recommended_action'
  type          String
  title         String
  description   String
  // Optional: affected entity
  entityType    String?
  entityId      String?
  // JSON: { reasoning, confidence, affectedModules, suggestedActions }
  reasoning     String   @default("{}")
  confidence    Float    @default(0.5)
  // Status: 'open' | 'acknowledged' | 'resolved' | 'dismissed'
  status        String   @default("open")
  acknowledgedAt DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([organizationId, day, status])
  @@index([priority, status])
  @@index([type, status])
  @@index([entityType, entityId])
}


// =============================================================================
// PHASE 5A.2 — UNIVERSAL ASSESSMENT, CREDENTIALING & ACADEMIC INTEGRITY PLATFORM
// =============================================================================
// All models are ADDITIVE — no existing schema changes.

// ---------------------------------------------------------------------------
// Competency Framework
// ---------------------------------------------------------------------------

model Competency {
  id              String   @id @default(cuid())
  // Stable code, e.g. "math.algebra.factoring"
  code            String   @unique
  name            String
  description     String?
  subject         String?
  // Competency level: 'foundational' | 'intermediate' | 'advanced' | 'expert'
  level           String   @default("intermediate")
  // Linked concept IDs (from Phase 4F.5)
  conceptIds      String   @default("[]")
  // Linked assessment IDs
  assessmentIds   String   @default("[]")
  // Linked resource IDs
  resourceIds     String   @default("[]")
  // Prerequisite competency IDs
  prerequisiteIds String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  evidence        CompetencyEvidence[]
  credentials     DigitalCredential[]

  @@index([subject, level])
  @@index([code])
}

model CompetencyEvidence {
  id              String   @id @default(cuid())
  competencyId    String
  competency      Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  userId          String
  // What evidence type: 'assessment' | 'project' | 'quiz' | 'observation' | 'portfolio'
  evidenceType    String
  entityId        String?
  // Mastery level demonstrated: 0-1
  masteryLevel    Float    @default(0)
  // 'pending' | 'verified' | 'rejected'
  status          String   @default("pending")
  verifiedBy      String?
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([competencyId, userId])
  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Digital Credentials
// ---------------------------------------------------------------------------

model DigitalCredential {
  id              String   @id @default(cuid())
  // 'certificate' | 'badge' | 'micro_credential' | 'competency_certificate' | 'course_certificate' | 'organization_certificate'
  type            String
  title           String
  description     String?
  // Recipient
  userId          String
  // Issuer
  issuerId        String
  issuerType      String   @default("organization")  // 'organization' | 'platform' | 'teacher'
  // Verification
  verificationId  String   @unique
  verificationUrl String?
  // QR code data (base64 or URL)
  qrCodeData      String?
  // Digital signature (JSON: { algorithm, signature, publicKey })
  digitalSignature String?
  // Achievement metadata
  metadata        String   @default("{}")
  // Linked competency IDs
  competencyIds   String   @default("[]")
  // Linked evidence (assessment IDs, project IDs, etc.)
  evidenceLinks   String   @default("[]")
  // Issue + expiry
  issuedAt        DateTime @default(now())
  expiresAt       DateTime?
  // Status
  status          String   @default("active")  // 'active' | 'revoked' | 'expired'
  revokedAt       DateTime?
  revokeReason    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  competencies    Competency[]

  @@index([userId, status])
  @@index([issuerId])
  @@index([type, status])
  @@index([verificationId])
}

// ---------------------------------------------------------------------------
// Lifelong Academic Transcript
// ---------------------------------------------------------------------------

model AcademicTranscript {
  id              String   @id @default(cuid())
  userId          String   @unique
  // JSON: { entries: TranscriptEntry[], summary: {...}, skills: [...], timeline: [...] }
  entries         String   @default("[]")
  // AI-generated summary
  aiSummary       String?
  aiSummaryAt     DateTime?
  // Skills extracted from all entries
  skills          String   @default("[]")
  // Timeline of learning milestones
  timeline        String   @default("[]")
  // Stats
  totalCourses    Int      @default(0)
  totalCredits    Int      @default(0)
  avgScore        Float    @default(0)
  totalCredentials Int     @default(0)
  totalCompetencies Int    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Assessment Intelligence — item analysis + quality metrics
// ---------------------------------------------------------------------------

model AssessmentItem {
  id              String   @id @default(cuid())
  assessmentId    String
  questionId      String?
  // Item statistics
  // Difficulty index: 0-1 (proportion of students who answered correctly)
  difficultyIndex Float?
  // Discrimination index: how well the item differentiates high vs low performers
  discriminationIndex Float?
  // Distractor effectiveness: JSON { distractorId, selectionRate }
  distractorAnalysis String?
  // Bloom level of this item
  bloomLevel      String?
  // Total attempts on this item
  attemptCount    Int      @default(0)
  // Correct answer count
  correctCount    Int      @default(0)
  // Average time spent on this item (ms)
  avgTimeMs       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([assessmentId])
  @@index([questionId])
}

model AssessmentQuality {
  id              String   @id @default(cuid())
  assessmentId    String   @unique
  // Overall quality score 0-1
  overallQuality  Float    @default(0.5)
  // Bloom coverage: JSON { remember: N, understand: N, apply: N, ... }
  bloomCoverage   String   @default("{}")
  // Curriculum coverage: fraction of standards assessed
  curriculumCoverage Float @default(0)
  // Difficulty distribution: JSON { easy: N, medium: N, hard: N }
  difficultyDistribution String @default("{}")
  // Grading consistency: 0-1 (how consistent across graders)
  gradingConsistency Float @default(0.5)
  // Fairness score: 0-1 (bias detection)
  fairnessScore   Float    @default(0.5)
  // Item analysis summary
  itemAnalysis    String   @default("{}")
  // AI-generated recommendations
  recommendations String   @default("[]")
  analyzedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([assessmentId])
}

// ---------------------------------------------------------------------------
// Academic Integrity
// ---------------------------------------------------------------------------

model IntegrityCheck {
  id              String   @id @default(cuid())
  // What was checked
  entityType      String   // 'assessment_attempt' | 'assignment_submission' | 'essay'
  entityId        String
  userId          String
  // Check type: 'plagiarism' | 'ai_generated' | 'duplicate_submission' | 'collusion' | 'unusual_behavior' | 'answer_similarity' | 'identity_anomaly'
  checkType       String
  // Risk score 0-1 (higher = more suspicious)
  riskScore       Float    @default(0)
  // 'low' | 'medium' | 'high'
  riskLevel       String   @default("low")
  // Detailed findings (JSON)
