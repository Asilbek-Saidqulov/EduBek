/// AI prompt registry — one row per (promptId, version).
model OrchestratorPrompt {
  id              String   @id @default(cuid())
  promptId        String
  name            String
  description     String
  module          String
  version         Int
  versionTag      String
  template        String   
  variables       String   @default("[]")
