# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edubek
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/edubek

# Secrets (each must be >=32 bytes in production)
EDUBEK_SESSION_SECRET=dev-session-secret-64-bytes-random-DO-NOT-USE-IN-PROD-a1b2c3d4e5f6
EDUBEK_REFRESH_SECRET=dev-refresh-secret-64-bytes-random-DO-NOT-USE-IN-PROD-a1b2c3d4e5f6
EDUBEK_GUEST_SECRET=dev-guest-secret-64-bytes-random-DO-NOT-USE-IN-PROD-a1b2c3d4e5f6
EDUBEK_ENCRYPTION_KEY=dev-encryption-key-32-bytes!DO-NOT-USE-IN-PROD

# AI Provider — OpenRouter (primary)
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash
OPENROUTER_REFERER=https://edubek.app

# AI Provider — OpenAI-compatible (alternative)
# Set OPENROUTER_API_KEY to empty + set these to use OpenAI directly
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# AI Provider — Anthropic (alternative)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3.5-sonnet

# Click Payment
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_USER_ID=
CLICK_CALLBACK_URL=

# Socket.IO CORS (comma-separated, empty = dev wildcard)
EDUBEK_ALLOWED_ORIGINS=
